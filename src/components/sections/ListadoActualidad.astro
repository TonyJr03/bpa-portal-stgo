---
/**
 * @seccion   src/components/sections/ListadoActualidad.astro
 *
 * @descripcion
 *   Sección que encapsula el widget Vue del listado de Actualidad.
 *   Actúa como capa intermedia entre la página .astro y la isla Vue:
 *     · Lee el idioma activo de la URL mediante getLangFromUrl()
 *     · Lo propaga a la isla Vue como prop `lang`
 *     · Proporciona un contenedor estilizado mediante WidgetWrapper
 *
 * @isla  ActualidadListado.vue  →  colección: noticias
 *        client:load porque es el contenido principal y debe estar listo
 *        inmediatamente al cargar.
 *
 * @props
 *   id?          string   — id HTML del WidgetWrapper (para anclas)
 *   isDark?      boolean  — activa la variante oscura del wrapper
 *   classes?     Record<string, string> — clases extra para el contenedor
 *
 * @uso
 *   <ListadoActualidad id="actualidad" />
 */

import WidgetWrapper     from '~/components/ui/WidgetWrapper.astro';
import ActualidadListado from '~/components/vue/ActualidadListado.vue';
import type { Widget }   from '~/types';
import { getLangFromUrl } from '~/i18n/utils';

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = Widget;

const {
  id,
  isDark = false,
  classes = {},
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`}
>
  
  <ActualidadListado client:load lang={lang} />

  <Fragment slot="bg"><slot name="bg" /></Fragment>
</WidgetWrapper>
