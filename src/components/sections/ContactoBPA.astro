---
/**
 * @seccion   src/components/sections/ContactoBPA.astro
 *
 * @descripcion
 *   Sección de contacto que encapsula el formulario de contacto y la información
 *   de atención. Actúa como capa intermedia entre la página .astro y la isla Vue:
 *     · Lee el idioma activo de la URL mediante getLangFromUrl()
 *     · Lo propaga a la isla Vue como prop `lang`
 *     · Obtiene las traducciones según el idioma detectado
 *     · Genera permalinks localizados para los enlaces
 *     · Recibe contenido dinámico mediante slots para titular y subtítulo
 *
 * @isla  FormularioContacto.vue
 *        client:load porque es un elemento interactivo importante.
 *
 * @props
 *   id?          string   — id HTML del WidgetWrapper (para anclas)
 *   isDark?      boolean  — activa la variante oscura del wrapper
 *   classes?     Record<string, string> — clases extra para el contenedor
 *   tagline?     string   — tagline del titular (puede venir de slot)
 *   title?       string   — título principal (puede venir de slot)
 *   subtitle?    string   — subtítulo (puede venir de slot)
 *
 * @uso
 *   <ContactoBPA id="contacto" />
 */

import WidgetWrapper      from '~/components/ui/WidgetWrapper.astro';
import FormularioContacto from '~/components/vue/FormularioContacto.vue';
import { Icon }           from 'astro-icon/components';
import type { Widget }    from '~/types';
import { useTranslations, getLangFromUrl } from '~/i18n/utils';
import { getPermalink }   from '~/utils/permalinks';

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = Widget;

const {
  id,
  isDark = false,
  classes = {},
} = Astro.props;

const bg = await Astro.slots.render('bg');
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14 items-start">

    <!-- Formulario -->
    <div class="lg:col-span-2">
      <div class="mb-6">
        <h2 class="text-2xl font-bold font-heading text-default dark:text-default">
          {t('form.write.title')}
        </h2>
        <p class="mt-1 text-muted text-sm">{t('form.write.subtitle')}</p>
      </div>
      <FormularioContacto client:load lang={lang} />
    </div>

    <!-- Aside estático -->
    <aside class="space-y-5 lg:pt-[4.5rem]">

      <div class="rounded-xl border border-bpa-100 dark:border-bpa-amber-800 bg-bpa-50 dark:bg-bpa-950/60 p-6">
        <h3 class="text-base font-semibold font-heading text-default dark:text-default mb-4 flex items-center gap-2">
          <Icon name="tabler:building-bank" class="w-5 h-5 text-primary shrink-0" />
          {t('contact.aside.title')}
        </h3>
        <ul class="space-y-3.5 text-sm text-muted dark:text-muted">
          <li class="flex gap-3">
            <Icon name="tabler:map-pin" class="w-4 h-4 mt-0.5 shrink-0 text-primary" />
            <span>[COMPLETAR: Calle, número, entre calles, Santiago de Cuba]</span>
          </li>
          <li class="flex gap-3">
            <Icon name="tabler:phone" class="w-4 h-4 mt-0.5 shrink-0 text-primary" />
            <span>
              {lang === 'es' ? 'Recepción' : 'Reception'}: <strong class="text-default dark:text-default">[COMPLETAR]</strong><br/>
              {lang === 'es' ? 'Atención al Cliente' : 'Customer Service'}: <strong class="text-default dark:text-default">[COMPLETAR]</strong>
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="tabler:mail" class="w-4 h-4 mt-0.5 shrink-0 text-primary" />
            <span>[COMPLETAR: atencion@bpa.scu.cu]</span>
          </li>
          <li class="flex gap-3">
            <Icon name="tabler:clock" class="w-4 h-4 mt-0.5 shrink-0 text-primary" />
            <span>
              {lang === 'es' ? 'Lunes a Viernes' : 'Monday to Friday'}<br/>
              <strong class="text-default dark:text-default">[COMPLETAR: 8:00 am – 4:00 pm]</strong>
            </span>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 p-5 text-sm text-amber-800 dark:text-amber-300">
        <p class="font-semibold mb-1.5 flex items-center gap-2">
          <Icon name="tabler:info-circle" class="w-4 h-4 shrink-0" />
          {t('contact.aside.deadline.title')}
        </p>
        <p set:html={t('contact.aside.deadline.text')} />
      </div>

      <a href={p('sobre-nosotros/nuestra-red/canales-de-atencion')}
        class="flex items-center gap-2 text-sm font-medium text-primary dark:text-primary hover:underline">
        <Icon name="tabler:arrow-right" class="w-4 h-4 shrink-0" />
        {t('contact.aside.channels.link')}
      </a>

    </aside>
  </div>
</WidgetWrapper>
