---
/**
 * @componente  src/components/sections/AtajosPortal.astro
 *
 * @descripcion
 *   Cuadrícula de accesos rápidos a las cuatro secciones principales
 *   del portal BPA. Pensada para la página 404 para que el usuario
 *   pueda reorientarse con un solo clic sin necesidad de usar el menú.
 *
 *   Las cuatro secciones son:
 *     · Productos      →  /productos
 *     · Trámites       →  /tramites
 *     · Herramientas   →  /herramientas
 *     · Sobre Nosotros →  /sobre-nosotros
 *
 *   Usa <Icon> de astro-icon con iconos tabler, igual que el resto del portal.
 *   Componente 100% estático (SSG puro), sin islas Vue.
 *
 * @uso
 * ```astro
 * import AtajosPortal from '~/components/sections/AtajosPortal.astro';
 * <AtajosPortal />
 * ```
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (secciones fijas del portal).
 */

import { Icon }         from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

const atajos = [
  {
    href:  getPermalink('/productos'),
    label: 'Productos',
    icon:  'tabler:building-bank',
  },
  {
    href:  getPermalink('/tramites'),
    label: 'Trámites',
    icon:  'tabler:file-text',
  },
  {
    href:  getPermalink('/herramientas'),
    label: 'Herramientas',
    icon:  'tabler:tools',
  },
  {
    href:  getPermalink('/sobre-nosotros'),
    label: 'Sobre Nosotros',
    icon:  'tabler:info-circle',
  },
];
---

<!-- Divisor con etiqueta central -->
<div class="flex items-center gap-4 mb-6 max-w-xs mx-auto">
  <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
  <span class="text-xs font-medium text-muted uppercase tracking-widest whitespace-nowrap">
    Secciones del portal
  </span>
  <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
</div>

<!-- Cuadrícula de atajos — 4 tarjetas de altura fija y uniforme -->
<nav aria-label="Navegación de recuperación">
  <ul class="grid grid-cols-4 gap-3 max-w-lg mx-auto list-none p-0 m-0">
    {atajos.map(({ href, label, icon }) => (
      <li class="flex">
        <a
          href={href}
          class="group flex flex-col items-center justify-center gap-2 w-full h-20 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-3 text-xs font-medium text-center text-default dark:text-slate-300 hover:border-primary dark:hover:border-primary hover:text-primary dark:hover:text-primary hover:shadow-sm transition-all duration-200"
        >
          <Icon
            name={icon}
            class="w-5 h-5 shrink-0 text-muted group-hover:text-primary dark:text-slate-400 dark:group-hover:text-primary transition-colors"
          />
          <span class="leading-tight">{label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
