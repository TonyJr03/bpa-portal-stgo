---
/**
 * @seccion   src/components/sections/Herramienta.astro
 *
 * @descripcion
 *   Sección unificada para las cuatro herramientas interactivas del portal BPA.
 *   Actúa como capa intermedia entre la página .astro y la isla Vue:
 *     · Lee el idioma activo de la URL mediante getLangFromUrl()
 *     · Lo propaga a la isla Vue como prop `lang`
 *     · Aplica el ancho máximo del contenedor según la herramienta
 *
 * @props
 *   herramienta  'calculadora' | 'tasas' | 'calendario' | 'mapa'  (requerido)
 *   id?          string   — id HTML del WidgetWrapper (para anclas)
 *   isDark?      boolean  — activa la variante oscura del wrapper
 *   classes?     Record<string, string> — clases extra para el contenedor
 *
 * @uso
 *   <Herramienta herramienta="calculadora" id="calculadora" />
 *   <Herramienta herramienta="mapa" id="mapa" />
 */

import WidgetWrapper         from '~/components/ui/WidgetWrapper.astro';
import CalculadoraFinanciera from '~/components/vue/CalculadoraFinanciera.vue';
import TasasDeCambio         from '~/components/vue/TasasDeCambio.vue';
import CalendarioEventos     from '~/components/vue/CalendarioEventos.vue';
import MapaSucursales        from '~/components/vue/MapaSucursales.vue';
import type { Widget } from '~/types';
import { getLangFromUrl } from '~/i18n/utils';

// ── Configuración de ancho por herramienta ────────────────────────────────────
const CONFIG = {
  calculadora: { maxWidth: 'max-w-2xl' },
  tasas:       { maxWidth: 'max-w-4xl' },
  calendario:  { maxWidth: 'max-w-3xl' },
  mapa:        { maxWidth: 'max-w-6xl' },
} as const;

type TipoHerramienta = keyof typeof CONFIG;

// ── Props ─────────────────────────────────────────────────────────────────────
interface Props extends Widget {
  herramienta: TipoHerramienta;
}

const {
  herramienta,
  id,
  isDark = false,
  classes = {},
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const { maxWidth } = CONFIG[herramienta];
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`${maxWidth} mx-auto ${classes?.container ?? ''}`}
>

  <!--
    Las islas se declaran de forma estática (requisito de Astro).
    Solo se monta la que corresponde al prop `herramienta` recibido.
    El prop `lang` permite a cada isla usar el diccionario correcto
    en el cliente, donde Astro.url no está disponible.
  -->
  {herramienta === 'calculadora' && (
    <CalculadoraFinanciera lang={lang} client:load />
  )}

  {herramienta === 'tasas' && (
    <TasasDeCambio lang={lang} client:load />
  )}

  {herramienta === 'calendario' && (
    <CalendarioEventos lang={lang} client:load />
  )}

  {herramienta === 'mapa' && (
    <MapaSucursales lang={lang} client:load />
  )}

  <Fragment slot="bg"><slot name="bg" /></Fragment>
</WidgetWrapper>
