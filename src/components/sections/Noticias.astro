---
/**
 * @seccion   src/components/sections/Noticias.astro
 *
 * @descripcion
 *   Sección "Últimas Noticias" de la página de inicio.
 *   Encapsula la isla Vue UltimasNoticias con su Headline y el enlace
 *   "Ver todas las noticias" que pre-filtra la página /actualidad.
 *
 *   Si no hay noticias publicadas, la isla es silenciosa (no renderiza nada)
 *   pero el Headline y el enlace siguen visibles. En producción se asume
 *   que siempre habrá noticias; durante desarrollo el admin puede omitir
 *   registros de esta categoría sin romper la página.
 *
 * @isla  UltimasNoticias.vue  →  client:visible
 *        colección: actualidad (categoria = "noticia")
 */

import WidgetWrapper   from '~/components/ui/WidgetWrapper.astro';
import Headline        from '~/components/ui/Headline.astro';
import UltimasNoticias from '~/components/vue/UltimasNoticias.vue';
import { Icon }        from 'astro-icon/components';
import type { Widget } from '~/types';

const {
  id,
  isDark  = false,
  classes = {},
} = Astro.props as Widget;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-6xl ${classes?.container ?? ''}`}
>
  <Headline
    tagline="Noticias"
    title="Últimas Noticias"
    subtitle="Novedades del sector financiero y del Banco Popular de Ahorro."
    classes={{ container: 'text-center max-w-3xl mx-auto mb-10' }}
  />

  <UltimasNoticias client:visible />

  <!-- Enlace pre-filtrado a la sección de noticias en /actualidad -->
  <div class="text-center mt-8">
    <a
      href="/actualidad?categoria=noticia"
      class="inline-flex items-center gap-2 text-sm font-medium
             text-primary dark:text-primary hover:underline underline-offset-4 transition-colors">
      Ver todas las noticias
      <Icon name="tabler:arrow-right" class="w-4 h-4" />
    </a>
  </div>

  <Fragment slot="bg">
    <slot name="bg" />
  </Fragment>
</WidgetWrapper>
