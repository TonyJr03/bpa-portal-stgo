---
/**
 * @seccion   src/components/sections/Noticias.astro
 *
 * @descripcion
 *   Sección que muestra las últimas noticias con un titular y enlace.
 *   Actúa como capa intermedia entre la página .astro y la isla Vue:
 *     · Lee el idioma activo de la URL mediante getLangFromUrl()
 *     · Lo propaga a la isla Vue como prop `lang`
 *     · Obtiene las traducciones según el idioma detectado
 *
 * @isla  UltimasNoticias.vue
 *        client:visible para optimizar el tiempo de carga inicial.
 *
 * @props
 *   id?          string   — id HTML del WidgetWrapper (para anclas)
 *   isDark?      boolean  — activa la variante oscura del wrapper
 *   classes?     Record<string, string> — clases extra para el contenedor
 *
 * @uso
 *   <Noticias id="noticias" />
 */

import WidgetWrapper   from '~/components/ui/WidgetWrapper.astro';
import Headline        from '~/components/ui/Headline.astro';
import UltimasNoticias from '~/components/vue/UltimasNoticias.vue';
import { Icon }        from 'astro-icon/components';
import type { Widget } from '~/types';
import { useTranslations, getLangFromUrl } from '~/i18n/utils';

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = Widget;

const {
  id,
  isDark = false,
  classes = {},
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl ${classes?.container ?? ''}`}>
  <Headline
    tagline={t('home.articles.tagline')}
    title={t('home.articles.title')}
    subtitle={t('home.articles.subtitle')}
    classes={{ container: 'text-center max-w-3xl mx-auto mb-10' }}
  />

  <UltimasNoticias client:visible lang={lang} />

  <div class="text-center mt-8">
    <a href={`/${lang}/actualidad?categoria=noticia`}
      class="inline-flex items-center gap-2 text-sm font-medium text-primary dark:text-primary hover:underline underline-offset-4 transition-colors">
      {t('home.articles.viewAll')}
      <Icon name="tabler:arrow-right" class="w-4 h-4" />
    </a>
  </div>

  <Fragment slot="bg"><slot name="bg" /></Fragment>
</WidgetWrapper>
