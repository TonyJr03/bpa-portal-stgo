---
/**
 * @componente  src/components/sections/AccesoRapidoHome.astro
 *
 * @descripcion
 *   Sección "Acceso Rápido" de la página de inicio.
 *   Cuadrícula de 4 tarjetas con las herramientas de uso diario.
 *
 *   Dos tarjetas son islas Vue con datos en tiempo real:
 *     → TasasMiniWidget.vue    (colección monedas)
 *     → CalendarioMiniWidget.vue (colección eventos)
 *
 *   Dos son enlaces estáticos:
 *     → Calculadora Financiera
 *     → Mapa de Sucursales
 *
 *   Paleta unificada BPA: todos los íconos usan bg-bpa-100/text-primary
 *   para coherencia con la identidad visual del banco.
 *
 * @islas
 *   TasasMiniWidget.vue      client:visible  →  colección monedas
 *   CalendarioMiniWidget.vue client:visible  →  colección eventos
 */

import WidgetWrapper        from '~/components/ui/WidgetWrapper.astro';
import Headline             from '~/components/ui/Headline.astro';
import TasasMiniWidget      from '~/components/vue/TasasMiniWidget.vue';
import CalendarioMiniWidget from '~/components/vue/CalendarioMiniWidget.vue';
import { Icon }             from 'astro-icon/components';

export interface Props {
  id?: string;
  isDark?: boolean;
}

const { id, isDark = false } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass="max-w-6xl">

  <Headline
    tagline="Herramientas"
    title="Acceso Rápido"
    subtitle="Las utilidades más consultadas por nuestros clientes, disponibles con un solo clic."
    classes={{ container: 'text-center max-w-3xl mx-auto mb-10' }}
  />

  <!-- Cuadrícula 2×2 en sm/md, 4 columnas en lg -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- ── TARJETA 1: Tasas de Cambio (isla Vue) ──────────────────────── -->
    <div class="flex flex-col rounded-2xl border border-bpa-200 dark:border-bpa-amber-800 bg-white dark:bg-bpa-950/60 shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden">

      <div class="px-5 pt-5 pb-3 border-b border-bpa-200/50 dark:border-bpa-amber-800/50">
        <div class="flex items-center gap-3 mb-1">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-bpa-100 dark:bg-bpa-800/40 text-primary dark:text-primary shrink-0">
            <Icon name="tabler:currency-dollar" class="w-5 h-5" />
          </span>
          <div>
            <h3 class="font-bold text-default dark:text-default text-sm leading-tight">
              Tasas de Cambio
            </h3>
            <p class="text-xs text-muted dark:text-muted">Valores en CUP</p>
          </div>
        </div>
      </div>

      <!-- Cuerpo: isla Vue -->
      <div class="flex-1 px-5 py-4">
        <TasasMiniWidget client:visible />
      </div>

      <!-- Pie -->
      <a
        href="/herramientas/tasas-de-cambio"
        class="flex items-center justify-between px-5 py-3 bg-bpa-50 dark:bg-bpa-950/80 border-t border-bpa-200/50 dark:border-bpa-amber-800/50 text-sm font-medium text-primary dark:text-primary hover:bg-bpa-100/50 dark:hover:bg-bpa-800/30 transition-colors group"
      >
        <span>Ver detalles y conversor</span>
        <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
      </a>
    </div>

    <!-- ── TARJETA 2: Calculadora Financiera (estática) ───────────────── -->
    <a
      href="/herramientas/calculadora"
      class="group flex flex-col rounded-2xl border border-bpa-200 dark:border-bpa-amber-800 bg-white dark:bg-bpa-950/60 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden"
    >
      <div class="flex-1 flex flex-col items-center justify-center px-5 py-8 text-center">
        <span class="flex items-center justify-center w-14 h-14 rounded-2xl bg-bpa-100 dark:bg-bpa-800/40 text-primary dark:text-primary mb-4 group-hover:scale-110 transition-transform duration-300">
          <Icon name="tabler:calculator" class="w-7 h-7" />
        </span>
        <h3 class="font-bold text-default dark:text-default text-base mb-2">
          Calculadora Financiera
        </h3>
        <p class="text-sm text-muted dark:text-muted leading-relaxed">
          Simule cuotas de créditos, rendimientos de ahorro y tablas de amortización.
        </p>
      </div>

      <!-- Pie -->
      <div class="flex items-center justify-between px-5 py-3 bg-bpa-50 dark:bg-bpa-950/80 border-t border-bpa-200/50 dark:border-bpa-amber-800/50 text-sm font-medium text-primary dark:text-primary group-hover:bg-bpa-100/50 dark:group-hover:bg-bpa-800/30 transition-colors">
        <span>Abrir calculadora</span>
        <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
      </div>
    </a>

    <!-- ── TARJETA 3: Mapa de Sucursales (estática) ────────────────────── -->
    <a
      href="/herramientas/mapa"
      class="group flex flex-col rounded-2xl border border-bpa-200 dark:border-bpa-amber-800 bg-white dark:bg-bpa-950/60 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden"
    >
      <div class="flex-1 flex flex-col items-center justify-center px-5 py-8 text-center">
        <span class="flex items-center justify-center w-14 h-14 rounded-2xl bg-bpa-100 dark:bg-bpa-800/40 text-primary dark:text-primary mb-4 group-hover:scale-110 transition-transform duration-300">
          <Icon name="tabler:map-pin" class="w-7 h-7" />
        </span>
        <h3 class="font-bold text-default dark:text-default text-base mb-2">
          Localizador de Oficinas
        </h3>
        <p class="text-sm text-muted dark:text-muted leading-relaxed">
          Encuentre la sucursal, caja de ahorro o cajero ATM más cercano en Santiago de Cuba.
        </p>
      </div>

      <!-- Pie -->
      <div class="flex items-center justify-between px-5 py-3 bg-bpa-50 dark:bg-bpa-950/80 border-t border-bpa-200/50 dark:border-bpa-amber-800/50 text-sm font-medium text-primary dark:text-primary group-hover:bg-bpa-100/50 dark:group-hover:bg-bpa-800/30 transition-colors">
        <span>Ver mapa interactivo</span>
        <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
      </div>
    </a>

    <!-- ── TARJETA 4: Calendario de Eventos (isla Vue) ─────────────────── -->
    <div class="flex flex-col rounded-2xl border border-bpa-200 dark:border-bpa-amber-800 bg-white dark:bg-bpa-950/60 shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden">

      <div class="px-5 pt-5 pb-3 border-b border-bpa-200/50 dark:border-bpa-amber-800/50">
        <div class="flex items-center gap-3">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-bpa-100 dark:bg-bpa-800/40 text-primary dark:text-primary shrink-0">
            <Icon name="tabler:calendar-event" class="w-5 h-5" />
          </span>
          <div>
            <h3 class="font-bold text-default dark:text-default text-sm leading-tight">
              Próximo Evento
            </h3>
            <p class="text-xs text-muted dark:text-muted">Calendario de pagos y feriados</p>
          </div>
        </div>
      </div>

      <!-- Cuerpo: isla Vue -->
      <div class="flex-1 px-5 py-4">
        <CalendarioMiniWidget client:visible />
      </div>

      <!-- Pie -->
      <a
        href="/herramientas/calendario"
        class="flex items-center justify-between px-5 py-3 bg-bpa-50 dark:bg-bpa-950/80 border-t border-bpa-200/50 dark:border-bpa-amber-800/50 text-sm font-medium text-primary dark:text-primary hover:bg-bpa-100/50 dark:hover:bg-bpa-800/30 transition-colors group"
      >
        <span>Ver calendario completo</span>
        <Icon name="tabler:arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
      </a>
    </div>

  </div>
</WidgetWrapper>
