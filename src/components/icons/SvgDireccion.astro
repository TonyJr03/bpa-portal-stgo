---
/**
 * @componente  src/components/icons/SvgDireccion.astro
 *
 * @descripcion
 * Ilustración SVG institucional para la página de Dirección Provincial.
 * Diseño: fachada estilizada de un edificio bancario con frontón, columnas
 * y escalinata — evoca solidez, institucionalidad y presencia territorial.
 *
 * Se usa como slot `image` en el widget Content de direccion-provincial.astro:
 *   <Content ...>
 *     <SvgDireccion slot="image" />
 *   </Content>
 *
 * Paleta adaptada a modo claro/oscuro con clases Tailwind.
 * 100 % SVG puro — sin dependencias externas. Apto para entorno air-gapped.
 */
---

<div class="flex items-center justify-center h-full py-8 lg:py-0">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 320 280"
    class="w-64 h-56 lg:w-80 lg:h-72"
    aria-hidden="true"
    role="presentation"
  >
    <!-- ── Cielo / fondo ─────────────────────────────────────────────────── -->
    <rect x="20" y="20" width="280" height="180" rx="4"
          fill="currentColor" class="text-bpa-50 dark:text-slate-800"/>

    <!-- ── Sombra del edificio ───────────────────────────────────────────── -->
    <rect x="58" y="102" width="208" height="98" rx="2"
          fill="currentColor" class="text-bpa-100 dark:text-slate-700"/>

    <!-- ── Cuerpo principal del edificio ────────────────────────────────── -->
    <rect x="55" y="100" width="210" height="98" rx="2"
          fill="currentColor" class="text-white dark:text-slate-700"/>
    <rect x="55" y="100" width="210" height="98" rx="2" fill="none"
          stroke="currentColor" stroke-width="1.5"
          class="text-bpa-200 dark:text-slate-600"/>

    <!-- ── Frontón (triángulo superior) ─────────────────────────────────── -->
    <polygon points="150,52 290,100 10,100"
             fill="currentColor" class="text-primary dark:text-primary"/>
    <!-- Borde del frontón -->
    <polygon points="150,52 290,100 10,100" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
             class="text-bpa-800 dark:text-primary"/>

    <!-- Detalle interior del frontón -->
    <polygon points="150,62 275,100 25,100"
             fill="currentColor" class="text-primary/80 dark:text-bpa-400"/>

    <!-- ── Texto / franja institucional ─────────────────────────────────── -->
    <rect x="80" y="106" width="160" height="16" rx="2"
          fill="currentColor" class="text-bpa-50 dark:text-slate-600"/>
    <!-- Líneas simulando texto -->
    <rect x="95" y="110" width="80" height="3" rx="1"
          fill="currentColor" class="text-primary/40 dark:text-primary/40"/>
    <rect x="180" y="110" width="45" height="3" rx="1"
          fill="currentColor" class="text-primary/40 dark:text-primary/40"/>
    <rect x="108" y="115" width="55" height="2" rx="1"
          fill="currentColor" class="text-primary/30 dark:text-primary/30"/>

    <!-- ── Columnas ──────────────────────────────────────────────────────── -->
    <!-- Columna 1 -->
    <rect x="75"  y="125" width="18" height="68" rx="2"
          fill="currentColor" class="text-bpa-100 dark:text-slate-600"/>
    <rect x="75"  y="125" width="18" height="68" rx="2" fill="none"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-200 dark:text-slate-500"/>
    <!-- Columna 2 -->
    <rect x="115" y="125" width="18" height="68" rx="2"
          fill="currentColor" class="text-bpa-100 dark:text-slate-600"/>
    <rect x="115" y="125" width="18" height="68" rx="2" fill="none"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-200 dark:text-slate-500"/>
    <!-- Columna 3 -->
    <rect x="191" y="125" width="18" height="68" rx="2"
          fill="currentColor" class="text-bpa-100 dark:text-slate-600"/>
    <rect x="191" y="125" width="18" height="68" rx="2" fill="none"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-200 dark:text-slate-500"/>
    <!-- Columna 4 -->
    <rect x="231" y="125" width="18" height="68" rx="2"
          fill="currentColor" class="text-bpa-100 dark:text-slate-600"/>
    <rect x="231" y="125" width="18" height="68" rx="2" fill="none"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-200 dark:text-slate-500"/>

    <!-- ── Puerta principal ──────────────────────────────────────────────── -->
    <rect x="143" y="148" width="34" height="50" rx="3"
          fill="currentColor" class="text-primary dark:text-primary"/>
    <!-- Arco de la puerta -->
    <path d="M143,151 Q160,136 177,151" fill="none"
          stroke="currentColor" stroke-width="2"
          class="text-bpa-800 dark:text-bpa-200"/>
    <!-- División central de la puerta -->
    <line x1="160" y1="148" x2="160" y2="198"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-800 dark:text-bpa-200"/>
    <!-- Manija -->
    <circle cx="155" cy="175" r="2"
            fill="currentColor" class="text-bpa-50 dark:text-slate-300"/>
    <circle cx="165" cy="175" r="2"
            fill="currentColor" class="text-bpa-50 dark:text-slate-300"/>

    <!-- ── Escalinata ────────────────────────────────────────────────────── -->
    <rect x="42"  y="198" width="236" height="8"  rx="1"
          fill="currentColor" class="text-bpa-200 dark:text-slate-600"/>
    <rect x="30"  y="206" width="260" height="8"  rx="1"
          fill="currentColor" class="text-bpa-200 dark:text-slate-500"/>
    <rect x="18"  y="214" width="284" height="8"  rx="1"
          fill="currentColor" class="text-bpa-200 dark:text-slate-600"/>

    <!-- ── Suelo ─────────────────────────────────────────────────────────── -->
    <rect x="0" y="222" width="320" height="58" rx="0"
          fill="currentColor" class="text-bpa-50 dark:text-slate-800"/>
    <line x1="0" y1="222" x2="320" y2="222"
          stroke="currentColor" stroke-width="1"
          class="text-bpa-100 dark:text-slate-700"/>

    <!-- ── Ventanas laterales ────────────────────────────────────────────── -->
    <!-- Ventana izq arriba -->
    <rect x="80"  y="130" width="10" height="10" rx="1"
          fill="currentColor" class="text-bpa-50 dark:text-slate-500"/>
    <!-- Ventana der arriba -->
    <rect x="234" y="130" width="10" height="10" rx="1"
          fill="currentColor" class="text-bpa-50 dark:text-slate-500"/>

    <!-- ── Bandera / mástil (detalle) ────────────────────────────────────── -->
    <line x1="160" y1="20" x2="160" y2="52"
          stroke="currentColor" stroke-width="2"
          class="text-bpa-200 dark:text-slate-500"/>
    <polygon points="160,22 178,28 160,34"
             fill="currentColor" class="text-primary dark:text-primary"/>
  </svg>
</div>
