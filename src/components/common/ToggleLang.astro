---
import { Icon } from 'astro-icon/components';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  iconName?: string;
}

const {
  label = 'Cambiar idioma / Switch language',
  class: className = 'text-default dark:text-default hover:bg-bpa-100 dark:hover:bg-bpa-amber-800/40 focus:outline-none focus:ring-4 focus:ring-bpa-200 dark:focus:ring-bpa-amber-800 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6 md:w-5 md:h-5',
  iconName = 'tabler:world',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} data-aw-toggle-lang>
  <Icon name={iconName} class={iconClass} />
</button>