---
/**
 * @widget     DocumentosDescargables
 * @ruta       src/components/widgets/DocumentosDescargables.astro
 * @descripcion Widget que muestra un grid de tarjetas para descargar documentos.
 *
 *              Los archivos se sirven desde /descargas/{recordId}/{filename},
 *              que apunta directamente al storage local de PocketBase mediante
 *              un symlink en public/descargas/ → pb_data/storage/{collectionId}/.
 *
 *              Al ser same-origin, download="nombre legible" funciona de forma
 *              nativa. Cero JavaScript. Cero copias. Los archivos siguen
 *              viviendo exactamente donde PocketBase los guarda.
 *
 * @uso
 *   import DocumentosDescargables from '~/components/widgets/DocumentosDescargables.astro';
 *   import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';
 *
 *   const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
 *     id:      doc.id,
 *     nombre:  doc.nombre,
 *     archivo: doc.archivo,
 *     url:     pb.files.getURL(doc, doc.archivo),
 *     orden:   doc.orden,
 *   }));
 *
 *   <DocumentosDescargables
 *     documentos={documentosConUrl}
 *     error={dbErrorDocs}
 *     titulo="Documentos del trámite"
 *   />
 */

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon }      from 'astro-icon/components';
import type { Widget } from '~/types';
import { getLangFromUrl } from '~/i18n/utils';

// ── Interfaces ────────────────────────────────────────────────────────────────
export interface DocumentoConUrl {
  id: string;
  nombre: string;
  /** Nombre exacto del archivo en PocketBase storage. Ej: "planilla_xz8k123.pdf" */
  archivo: string;
  url: string;
  orden: number;
}

interface Props extends Widget {
  documentos: DocumentoConUrl[];
  error?: boolean;
  titulo?: string;
}

// ── Props ─────────────────────────────────────────────────────────────────────
const {
  documentos,
  error  = false,
  titulo = 'Documentos',
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const lang = getLangFromUrl(Astro.url);

// ── Helpers ───────────────────────────────────────────────────────────────────
function iconoPorExtension(nombreArchivo: string): string {
  const ext = nombreArchivo.split('.').pop()?.toLowerCase();
  switch (ext) {
    case 'pdf':         return 'tabler:file-type-pdf';
    case 'docx':
    case 'doc':         return 'tabler:file-type-doc';
    case 'xlsx':
    case 'xls':         return 'tabler:file-type-xls';
    case 'pptx':
    case 'ppt':         return 'tabler:file-type-ppt';
    case 'zip':
    case 'rar':         return 'tabler:file-zip';
    case 'txt':         return 'tabler:file-text';
    default:            return 'tabler:file-download';
  }
}

function extensionLegible(nombreArchivo: string): string {
  return nombreArchivo.split('.').pop()?.toUpperCase() ?? 'FILE';
}

/**
 * Construye la URL same-origin del archivo.
 * La integración copiarDocumentos lo copia a public/descargas/ con el
 * ID del registro como nombre, conservando la extensión original.
 * Ej: id="xzw7ostu", archivo="planilla_abc123.pdf"
 *     → "/descargas/xzw7ostu.pdf"
 */
function urlSameOrigin(docId: string, archivo: string): string {
  const ext = archivo.split('.').pop() ?? 'bin';
  return `/descargas/${docId}.${ext}`;
}

/**
 * Nombre legible para el atributo download.
 * Funciona porque la URL es same-origin — sin ningún JS.
 * Ej: nombre="Planilla de solicitud", archivo="planilla_abc123.pdf"
 *     → "Planilla de solicitud.pdf"
 */
function nombreDescarga(nombre: string, archivo: string): string {
  const ext = archivo.split('.').pop() ?? '';
  return ext ? `${nombre}.${ext}` : nombre;
}
---

{error ? (
  <div class="max-w-4xl mx-auto px-4 md:px-6 pb-8 intersect-once intersect-quarter intercept-no-queue motion-safe:opacity-0 motion-safe:intersect:animate-fade">
    <div class="rounded-lg border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 p-4 flex items-start">
      <Icon
        name="tabler:alert-triangle"
        class="w-5 h-5 text-amber-600 dark:text-amber-400 mt-0.5 shrink-0 mr-3"
      />
      <p class="text-sm text-amber-800 dark:text-amber-300">
        {lang === 'es'
          ? 'No se pudieron cargar los documentos descargables. Si el problema persiste, contacte al administrador del sistema.'
          : 'The downloadable documents could not be loaded. If the problem persists, please contact the system administrator.'
        }
      </p>
    </div>
  </div>

) : documentos.length > 0 ? (

  <WidgetWrapper
    id={id}
    isDark={isDark}
    containerClass={`max-w-4xl mx-auto pt-0 ${classes?.container ?? ''}`}
    bg={bg}
  >

    <div class="flex items-center gap-2 mb-5">
      <Icon
        name="tabler:paperclip"
        class="w-5 h-5 text-primary dark:text-primary"
      />
      <h2 class="text-xl font-bold font-heading tracking-tight text-default dark:text-default">
        {titulo}
      </h2>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2">
      {documentos.map((doc) => (
        <li>
          <a
            href={urlSameOrigin(doc.id, doc.archivo)}
            download={nombreDescarga(doc.nombre, doc.archivo)}
            class="
              flex items-center gap-4 rounded-lg border border-bpa-100
              bg-white dark:bg-bpa-950/60 dark:border-bpa-amber-800
              px-4 py-3
              hover:border-primary hover:shadow-md
              dark:hover:border-primary
              transition-all duration-200
              group
            "
            aria-label={`Descargar ${doc.nombre}`}
          >
            <Icon
              name={iconoPorExtension(doc.archivo)}
              class="w-8 h-8 text-primary dark:text-primary shrink-0 group-hover:scale-110 transition-transform"
            />

            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-default dark:text-default truncate">
                {doc.nombre}
              </p>
              <p class="text-xs text-muted dark:text-muted mt-0.5">
                {extensionLegible(doc.archivo)}
              </p>
            </div>

            <Icon
              name="tabler:download"
              class="w-4 h-4 text-primary dark:text-primary shrink-0 group-hover:text-secondary dark:group-hover:text-secondary transition-colors"
            />
          </a>
        </li>
      ))}
    </ul>

  </WidgetWrapper>

) : null}
