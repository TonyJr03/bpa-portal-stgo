---
/**
 * @componente  src/components/widgets/MapaWidget.astro
 *
 * @descripcion
 *   Capa de presentación SSG del módulo de mapa interactivo.
 *   Responsabilidades:
 *     · WidgetWrapper con contenedor amplio (max-w-6xl)
 *     · Headline opcional (título + subtítulo)
 *     · Montar la isla Vue MapaSucursales con client:load
 *
 * @NO_hace
 *   Nada de lógica de datos, filtros ni PocketBase — eso es de MapaSucursales.vue
 *
 * @uso_en  src/pages/herramientas/mapa.astro
 */

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline      from '~/components/ui/Headline.astro';
import MapaSucursales from '~/components/vue/MapaSucursales.vue';

interface Props {
  /** Título del bloque (opcional — lo puede mostrar la página padre) */
  titulo?:   string;
  /** Subtítulo descriptivo */
  subtitulo?: string;
  /** Clases extra para el wrapper */
  claseExtra?: string;
}

const {
  titulo    = '',
  subtitulo = '',
  claseExtra = '',
} = Astro.props;
---

<WidgetWrapper
  id="mapa-sucursales"
  containerClass={`max-w-6xl mx-auto ${claseExtra}`}
>
  <!-- Headline solo si se pasa título -->
  {titulo && (
    <Headline
      title={titulo}
      subtitle={subtitulo}
      classes={{ container: 'mb-8 text-center' }}
    />
  )}

  <!--
    Isla Vue: client:load asegura hidratación inmediata.
    El componente maneja internamente sus estados: cargando / error / datos.
  -->
  <MapaSucursales client:load />
</WidgetWrapper>
