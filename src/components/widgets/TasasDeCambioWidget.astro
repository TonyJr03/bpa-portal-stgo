---
/**
 * @widget  src/components/widgets/TasasDeCambioWidget.astro
 *
 * @descripcion
 * Widget institucional del módulo Tasas de Cambio. Sigue exactamente el
 * patrón AstroWind (WidgetWrapper + Headline + contenido), igual que
 * ContactoBPA.astro. Generado en build time — cero JS propio al cliente.
 *
 * Responsabilidades de este widget:
 *   · WidgetWrapper  → padding, max-width, fondo de sección
 *   · Headline       → tagline + title + subtitle (opcionales)
 *   · Nota informativa estática sobre compra/venta
 *   · Inyección de la isla Vue <TasasDeCambio client:load />
 *
 * Lo que NO hace este widget:
 *   · Consultar PocketBase (lo hace la isla en el cliente)
 *   · Gestionar estado de carga, error o datos (lo hace la isla)
 *   · Renderizar la tabla ni el conversor (los renderiza la isla)
 *
 * @uso
 * ```astro
 * import TasasDeCambioWidget from '~/components/widgets/TasasDeCambioWidget.astro';
 *
 * <!-- Sin Headline — el HeroText de la página ya hace ese papel -->
 * <TasasDeCambioWidget id="tasas">
 *   <Fragment slot="bg">
 *     <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
 *   </Fragment>
 * </TasasDeCambioWidget>
 *
 * <!-- Con Headline completo (uso futuro desde otras páginas) -->
 * <TasasDeCambioWidget
 *   tagline="Herramientas"
 *   title="Divisas operadas por el BPA"
 *   subtitle="Tasas actualizadas en tiempo real."
 * />
 * ```
 *
 * @props
 *   tagline?  string  — etiqueta pequeña sobre el título
 *   title?    string  — título principal de la sección
 *   subtitle? string  — subtítulo descriptivo
 *   Extiende Widget: id?, isDark?, bg (slot), classes?
 */

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline      from '~/components/ui/Headline.astro';
import TasasDeCambio from '~/components/vue/TasasDeCambio.vue';

interface Props {
  tagline?:  string;
  title?:    string;
  subtitle?: string;
  id?:       string;
  isDark?:   boolean;
  classes?:  Record<string, string>;
}

const {
  tagline,
  title,
  subtitle,
  id,
  isDark = false,
  classes = {},
} = Astro.props;

/** El Headline solo se renderiza si al menos uno de sus props tiene valor */
const tieneHeadline = tagline || title || subtitle;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-4xl mx-auto ${classes?.container ?? ''}`}>

  <Fragment slot="bg">
    <slot name="bg" />
  </Fragment>

  <!-- Headline opcional ───────────────────────────────────────────────────── -->
  {tieneHeadline && (
    <Headline
      tagline={tagline}
      title={title}
      subtitle={subtitle}
      classes={{
        container: 'mb-8',
        title:     'text-2xl md:text-3xl',
      }}
    />
  )}

  <!-- Isla Vue — toda la reactividad: fetch, tabla, conversor, estados ───── -->
  <TasasDeCambio client:load />

</WidgetWrapper>
