---
/**
 * @widget  src/components/widgets/CalculadoraWidget.astro
 *
 * @descripcion
 * Widget institucional del módulo Calculadora Financiera.
 * Sigue el patrón WidgetWrapper + Headline + isla Vue,
 * idéntico a TasasDeCambioWidget.astro y CalendarioWidget.astro.
 * Generado en build time — cero JS propio al cliente.
 *
 * Responsabilidades de este widget:
 *   · WidgetWrapper  → padding, max-width, fondo de sección
 *   · Headline       → tagline + title + subtitle (opcionales)
 *   · Inyección de la isla Vue <CalculadoraFinanciera client:load />
 *
 * Lo que NO hace este widget:
 *   · Ningún cálculo — todo ocurre en la isla Vue con computed()
 *   · Consultar PocketBase — componente completamente autónomo
 *
 * @uso
 * ```astro
 * import CalculadoraWidget from '~/components/widgets/CalculadoraWidget.astro';
 *
 * <CalculadoraWidget id="calculadora">
 *   <Fragment slot="bg">
 *     <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
 *   </Fragment>
 * </CalculadoraWidget>
 * ```
 *
 * @props
 *   tagline?  string  — etiqueta pequeña sobre el título
 *   title?    string  — título principal de la sección
 *   subtitle? string  — subtítulo descriptivo
 *   Extiende Widget: id?, isDark?, bg (slot), classes?
 */

import WidgetWrapper          from '~/components/ui/WidgetWrapper.astro';
import Headline               from '~/components/ui/Headline.astro';
import CalculadoraFinanciera  from '~/components/vue/CalculadoraFinanciera.vue';

interface Props {
  tagline?:  string;
  title?:    string;
  subtitle?: string;
  id?:       string;
  isDark?:   boolean;
  classes?:  Record<string, string>;
}

const {
  tagline,
  title,
  subtitle,
  id,
  isDark = false,
  classes = {},
} = Astro.props;

const tieneHeadline = tagline || title || subtitle;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-2xl mx-auto ${classes?.container ?? ''}`}>

  <Fragment slot="bg">
    <slot name="bg" />
  </Fragment>

  <!-- Headline opcional ───────────────────────────────────────────────────── -->
  {tieneHeadline && (
    <Headline
      tagline={tagline}
      title={title}
      subtitle={subtitle}
      classes={{
        container: 'mb-8',
        title:     'text-2xl md:text-3xl',
      }}
    />
  )}

  <!-- Isla Vue — pestañas, formularios, cálculos en tiempo real ──────────── -->
  <CalculadoraFinanciera client:load />

</WidgetWrapper>
