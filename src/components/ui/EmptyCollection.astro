---
/**
 * @componente  src/components/ui/EmptyCollection.astro
 *
 * @descripcion
 * Estado visual cuando PocketBase responde OK pero la colección está vacía.
 * El texto visible está orientado al cliente — sin referencias a PocketBase
 * ni a nombres de colecciones.
 * La nota técnica para el administrador queda en un bloque oculto.
 *
 * @props
 *   coleccion  string  — nombre de la colección (solo para el bloque oculto)
 *   mensaje?   string  — mensaje visible al cliente. Default: texto genérico
 *   icono?     string  — icono Tabler. Default: tabler:info-circle
 */

import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useLocalTranslations } from '~/i18n/utils';

export interface Props {
  coleccion: string;
  mensaje?: string;
  icono?: string;
}

const { coleccion, mensaje, icono = 'tabler:info-circle' } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const tl = useLocalTranslations(lang, {
  es: { default: 'Esta sección no tiene contenido disponible todavía.' },
  en: { default: 'This section has no content available yet.' },
});
const texto = mensaje ?? tl('default');
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 text-center
            intersect-once intersect-quarter intercept-no-queue
            motion-safe:opacity-0 motion-safe:intersect:animate-fade">
  <Icon
    name={icono}
    class="w-14 h-14 mx-auto mb-5 text-primary opacity-60"
    aria-hidden="true"
  />

  <p class="text-xl font-semibold text-default dark:text-white">
    {texto}
  </p>

  <!-- Bloque oculto: referencia técnica solo para el administrador -->
  <div hidden aria-hidden="true" data-debug-coleccion={coleccion}>
    <!-- Colección vacía: "{coleccion}". Añada registros desde el panel
        de administración de PocketBase con el campo publicado = true. -->
  </div>

</div>
