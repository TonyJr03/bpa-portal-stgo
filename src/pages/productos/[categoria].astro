---
/**
 * @pagina src/pages/productos/[categoria].astro
 * @ruta   /productos/[categoria]
 * @ejemplo /productos/banca-personal
 *
 * @descripcion
 * Página dinámica generada en build time para cada categoría de productos.
 * getStaticPaths consulta la colección `categorias` y genera una ruta por
 * cada registro. Cada ruta precarga también sus `productos` asociados en la
 * misma función, evitando una segunda consulta al renderizar.
 *
 * @colecciones
 *   `categorias` → nombre, slug, descripcion, icono, orden
 *   `productos`  → nombre, slug, categoria (Relation), descripcion,
 *                  icono, orden, publicado
 */

// ── Imports ────────────────────────────────────────────────────────────────────
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import EmptyCollection from '~/components/ui/EmptyCollection.astro';
import DatabaseError from '~/components/ui/DatabaseError.astro';
import { pb } from '~/lib/pocketbase';

// ── Interfaces ────────────────────────────────────────────────────────────────
interface Categoria {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  icono: string;
  orden: number;
}

interface Producto {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  icono: string;
  orden: number;
  publicado: boolean;
  // El campo `categoria` es una Relation — PocketBase devuelve el ID del registro
  categoria: string;
}

// ─── getStaticPaths ───────────────────────────────────────────────────────────
export const getStaticPaths = (async () => {
  const categorias = await pb.collection('categorias').getFullList<Categoria>({ 
    sort: 'orden'
  });

  const paths = await Promise.all(
    categorias.map(async (cat) => {
      let productos: Producto[] = [];
      let dbError = false;

      try {
        productos = await pb.collection('productos').getFullList<Producto>({
            filter: `categoria = "${cat.id}" && publicado = true`,
            sort: 'orden',
          });
      } catch {
        dbError = true;
      }

      return {
        params: { categoria: cat.slug },
        props: { categoria: cat, productos, dbError },
      };
    })
  );

  return paths;
}) satisfies GetStaticPaths;

// ─── PROPS ────────────────────────────────────────────────────────────────────
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { categoria, productos, dbError } = Astro.props;

// ─── MAPEO A Item[] para Features2 ───────────────────────────────────────────
const items = productos.map((prod) => ({
  title: prod.nombre,
  description: prod.descripcion,
  icon: `tabler:${prod.icono}`,
  callToAction: {
    text: 'Ver detalles',
    href: `/productos/${categoria.slug}/${prod.slug}`,
    variant: 'link' as const,
    icon: 'tabler:arrow-right',
  },
}));

// ─── METADATA SEO ─────────────────────────────────────────────────────────────
const metadata = {
  title: `${categoria.nombre} — BPA Santiago de Cuba`,
  description: categoria.descripcion,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ─────────────────────────────────────────────────────
      Nombre de la categoría como título principal.
      Descripción de PocketBase como subtítulo.
      Tagline contextualiza la ubicación dentro del portal.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline="Productos y Servicios"
    title={categoria.nombre}
    subtitle={categoria.descripcion}
  />

  <!-- BLOQUE 2 · Grid de productos / estados ──────────────────────────────────
      Tres casos posibles:
        1. Error de conexión en build time → DatabaseError
        2. Categoría sin productos         → EmptyCollection
        3. Productos disponibles           → Features2
  ─────────────────────────────────────────────────────────────────────────── -->
  {dbError ? (
    <DatabaseError coleccion="productos" />
  ) : items.length === 0 ? (
    <EmptyCollection
      coleccion="productos"
      mensaje={`No hay productos disponibles en ${categoria.nombre} aún.`}
      icono="tabler:package-off"
    />
  ) : (
    <Features2
      id="productos"
      tagline="Seleccione un producto"
      columns={3}
      items={items}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
      </Fragment>
    </Features2>
  )}

  <!-- BLOQUE 3 · CallToAction ─────────────────────────────────────────────────
      Mismo cierre institucional que el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Necesita orientación personalizada?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para asesorarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text: 'Contáctenos',
        href: '/contacto',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- NAVEGACIÓN · PageNav ────────────────────────────────────────────────────
      ← Volver a Productos y Servicios
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: 'Volver a Productos y Servicios', href: '/productos' }}
  />

</Layout>
