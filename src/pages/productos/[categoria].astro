---
/**
 * @pagina   src/pages/productos/[categoria].astro
 * @ruta     /productos/[categoria]
 * @ejemplo  /productos/banca-personal
 *
 * @descripcion
 * Página dinámica generada en build time para cada categoría de productos.
 * getStaticPaths itera sobre las 5 categorías definidas en src/data/categorias.ts
 * y por cada una carga sus productos publicados desde PocketBase.
 *
 * El campo `categoria` de la colección `productos` es de tipo Select y almacena
 * el slug de la categoría (ej: "banca-personal"), por lo que el filtro usa el
 * slug directamente — sin necesidad de IDs de PocketBase.
 *
 * @colecciones
 *   productos → nombre, slug, categoria (Select = slug), descripcion,
 *               icono, orden, publicado
 */

// ── Imports ────────────────────────────────────────────────────────────────────
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout          from '~/layouts/PageLayout.astro';
import HeroText        from '~/components/widgets/HeroText.astro';
import Features2       from '~/components/widgets/Features2.astro';
import CallToAction    from '~/components/widgets/CallToAction.astro';
import PageNav         from '~/components/widgets/PageNav.astro';
import EmptyCollection from '~/components/ui/EmptyCollection.astro';
import DatabaseError   from '~/components/ui/DatabaseError.astro';
import { CATEGORIAS }  from '~/data/categorias';
import type { Categoria } from '~/data/categorias';
import { pb, fetchParaBuild } from '~/lib/pocketbase';

// ── Interfaces ────────────────────────────────────────────────────────────────
interface Producto {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  icono: string;
  orden: number;
  publicado: boolean;
  /** Valor del campo Select en PocketBase — coincide con el slug de la categoría. */
  categoria: string;
}

// ── getStaticPaths ─────────────────────────────────────────────────────────────
// Itera sobre las 5 categorías estáticas y carga los productos de cada una.
// Toda la lógica de carga ocurre aquí. Cero consultas al renderizar.
export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    CATEGORIAS.map(async (cat: Categoria) => {
      // fetchParaBuild devuelve [] si PocketBase no está disponible (ej: CI/CD),
      // evitando que el build falle. dbError=true activa el componente DatabaseError.
      const productos = await fetchParaBuild<Producto>(
        () => pb.collection('productos').getFullList<Producto>({
          // Filtra por el valor del campo Select, que es el slug de la categoría
          filter: `categoria = "${cat.slug}" && publicado = true`,
          sort:   'orden',
        }),
        `productos/${cat.slug}`
      );

      // Si PocketBase no respondió, productos será [] y dbError lo refleja en la UI
      const dbError = productos.length === 0;

      return {
        params: { categoria: cat.slug },
        props:  { categoria: cat, productos, dbError },
      };
    })
  );

  return paths;
}) satisfies GetStaticPaths;

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { categoria, productos, dbError } = Astro.props;

// ── Mapeo a Item[] para Features2 ─────────────────────────────────────────────
const items = productos.map((prod) => ({
  title:       prod.nombre,
  description: prod.descripcion,
  icon:        `tabler:${prod.icono}`,
  callToAction: {
    text:    'Ver detalles',
    href:    `/productos/${categoria.slug}/${prod.slug}`,
    variant: 'link' as const,
    icon:    'tabler:arrow-right',
  },
}));

// ── Metadata SEO ──────────────────────────────────────────────────────────────
const metadata = {
  title:       `${categoria.nombre} — BPA Santiago de Cuba`,
  description: categoria.descripcion,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline contextualiza la ubicación dentro del portal.
      Title = nombre de la categoría. Subtitle = descripción de la categoría.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline="Productos y Servicios"
    title={categoria.nombre}
    subtitle={categoria.descripcion}
  />

  <!-- BLOQUE 2 · Features2 / estados ──────────────────────────────────────────
      Tres casos posibles según el resultado de la consulta a PocketBase:
        1. Error de conexión → DatabaseError
        2. Sin productos     → EmptyCollection
        3. Con productos     → Features2 con el grid
  ─────────────────────────────────────────────────────────────────────────── -->
  {dbError ? (
    <DatabaseError coleccion="productos" />
  ) : items.length === 0 ? (
    <EmptyCollection
      coleccion="productos"
      mensaje={`No hay productos disponibles en ${categoria.nombre} aún.`}
      icono="tabler:package-off"
    />
  ) : (
    <Features2
      id="productos"
      tagline="Seleccione un producto"
      columns={3}
      items={items}
    />
  )}

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional consistente con el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Necesita orientación personalizada?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para asesorarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text:    'Contáctenos',
        href:    '/contacto',
        icon:    'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Navegación contextual: regresa al índice de Productos y Servicios.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: 'Volver a Productos y Servicios', href: '/productos' }}
  />

</Layout>
