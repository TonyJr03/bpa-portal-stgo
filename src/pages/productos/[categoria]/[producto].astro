---
/**
 * @pagina   src/pages/productos/[categoria]/[producto].astro
 * @ruta     /productos/[categoria]/[producto]
 * @ejemplo  /productos/banca-personal/depositos-plazo-fijo
 *
 * @descripcion
 * Página de detalle de un producto o servicio individual. Muestra el contenido
 * completo renderizado desde HTML almacenado en PocketBase, más un bloque de
 * descarga de documentos asociados.
 *
 * getStaticPaths itera sobre las 5 categorías estáticas (src/data/categorias.ts),
 * carga los productos de cada una filtrando por el slug de la categoría, y por
 * cada producto carga sus documentos descargables. Todo el fetching ocurre aquí.
 *
 * @colecciones
 *   productos  → nombre, slug, categoria (Select = slug), descripcion,
 *                contenido (Plain Text / HTML), icono, orden, publicado
 *   documentos → nombre, archivo, referencia, tipo, orden,
 *                collectionId, collectionName
 *                Filtro: referencia = "{producto.slug}" && tipo = "producto"
 *
 * @patron  getStaticPaths: TODO el fetching ocurre aquí. Cero consultas al renderizar.
 */

// ── Imports ────────────────────────────────────────────────────────────────────
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout                  from '~/layouts/PageLayout.astro';
import HeroText                from '~/components/widgets/HeroText.astro';
import ProseContent           from '~/components/sections/ProseContent.astro';
import DocumentosDescargables  from '~/components/widgets/DocumentosDescargables.astro';
import CallToAction            from '~/components/widgets/CallToAction.astro';
import PageNav                 from '~/components/widgets/PageNav.astro';
import EmptyCollection         from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';
import { CATEGORIAS }          from '~/data/categorias';
import type { Categoria }      from '~/data/categorias';
import { pb, fetchParaBuild }  from '~/lib/pocketbase';

// ── Interfaces ────────────────────────────────────────────────────────────────
interface Producto {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  contenido: string;
  icono: string;
  orden: number;
  publicado: boolean;
  /** Valor del campo Select en PocketBase — coincide con el slug de la categoría. */
  categoria: string;
}

interface Documento {
  id: string;
  nombre: string;
  archivo: string;
  referencia: string;
  tipo: string;
  orden: number;
  collectionId: string;
  collectionName: string;
}

// ── getStaticPaths ─────────────────────────────────────────────────────────────
export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    CATEGORIAS.map(async (cat: Categoria) => {
      // fetchParaBuild devuelve [] si PocketBase no está disponible (ej: CI/CD),
      // lo que hace que este .map() produzca un array vacío y el build no falle.
      const productos = await fetchParaBuild<Producto>(
        () => pb.collection('productos').getFullList<Producto>({
          filter: `categoria = "${cat.slug}" && publicado = true`,
          sort:   'orden',
        }),
        `productos/${cat.slug}`
      );

      if (productos.length === 0) return [];

      // Por cada producto, cargar sus documentos descargables
      return Promise.all(
        productos.map(async (prod) => {
          let documentos: Documento[] = [];
          let dbErrorDocs = false;

          try {
            documentos = await pb.collection('documentos').getFullList<Documento>({
              filter: `referencia = "${prod.slug}" && tipo = "producto"`,
              sort:   'orden',
            });
          } catch (err) {
            console.error(`[BPA] Error cargando documentos para "${prod.slug}":`, err);
            dbErrorDocs = true;
          }

          return {
            params: { categoria: cat.slug, producto: prod.slug },
            props:  { producto: prod, categoria: cat, documentos, dbErrorDocs },
          };
        })
      );
    })
  );

  return paths.flat(2);
}) satisfies GetStaticPaths;

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { producto, categoria, documentos, dbErrorDocs } = Astro.props;

// ── Construcción de URLs de descarga ──────────────────────────────────────────
const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id:      doc.id,
  nombre:  doc.nombre,
  archivo: doc.archivo,
  url:     pb.files.getURL(doc, doc.archivo),
  orden:   doc.orden,
}));

// ── Metadata SEO ──────────────────────────────────────────────────────────────
const metadata = {
  title:       `${producto.nombre} — BPA Santiago de Cuba`,
  description: producto.descripcion,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline = nombre de la categoría para contextualizar la ubicación.
      Title = nombre del producto. Sin subtitle: el contenido habla por sí mismo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={categoria.nombre}
    title={producto.nombre}
  />

  <!-- BLOQUE 2 · ProseContent / EmptyCollection ───────────────────────────────
      Si el campo `contenido` tiene datos → renderiza el HTML con Typography.
      Si está vacío → EmptyCollection avisa que falta información detallada.
  ─────────────────────────────────────────────────────────────────────────── -->
  {producto.contenido?.trim()
    ? <ProseContent contenido={producto.contenido} />
    : <EmptyCollection
        coleccion="productos"
        mensaje="Aún no hay información detallada acerca de este servicio."
        icono="tabler:info-circle"
      />
  }

  <!-- BLOQUE 3 · DocumentosDescargables ───────────────────────────────────────
      Grid de archivos descargables asociados a este producto.
      - Si error=true  → aviso ámbar discreto (no bloquea la página).
      - Si array vacío → el componente no renderiza nada (silencioso).
      - Si hay docs    → grid de tarjetas con botón de descarga.
  ─────────────────────────────────────────────────────────────────────────── -->
  <DocumentosDescargables
    documentos={documentosConUrl}
    error={dbErrorDocs}
    titulo="Documentos relacionados"
  />

  <!-- BLOQUE 4 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional consistente con el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Necesita más información sobre este servicio?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para asesorarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text:    'Contáctenos',
        href:    '/contacto',
        icon:    'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Navegación contextual: regresa al listado de la categoría padre.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{
      text: `Volver a ${categoria.nombre}`,
      href: `/productos/${categoria.slug}`,
    }}
  />

</Layout>
