---
/**
 * @pagina  src/pages/productos/[categoria]/[producto].astro
 * @ruta    /productos/[categoria]/[producto]
 * @ejemplo /productos/banca-personal/depositos-plazo-fijo
 *
 * @descripcion
 * Pagina dinamica generada en build time para cada producto o servicio.
 * getStaticPaths consulta todas las categorias, sus productos publicados
 * y los documentos descargables de cada producto en una sola pasada.
 *
 * Widgets utilizados:
 *   - HeroText               -> Nombre del producto (sin subtitle)
 *                               Tagline = nombre de la categoria padre
 *   - ProseContent           -> Contenido HTML del campo `contenido` de PocketBase
 *                               renderizado con Tailwind Typography
 *   - DocumentosDescargables -> Grid de archivos descargables del producto
 *   - CallToAction           -> Cierre institucional
 *   - PageNav                -> Volver a la categoria padre
 *
 * Componentes de estado:
 *   - DatabaseError -> Fallo al cargar el contenido del producto en build time
 *
 * Colecciones PocketBase:
 *   categorias  -> id, nombre, slug
 *   productos   -> id, nombre, slug, categoria (Relation), descripcion,
 *                  contenido (Plain Text / HTML), icono, orden, publicado
 *   documentos  -> id, nombre, archivo, referencia, tipo, orden,
 *                  collectionId, collectionName
 *                  Filtro: referencia = "{producto.slug}" && tipo = "producto"
 *
 * @patron getStaticPaths: TODO el fetching ocurre aqui. Cero consultas al renderizar.
 */

// -- Imports -------------------------------------------------------------------
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout                 from '~/layouts/PageLayout.astro';
import HeroText               from '~/components/widgets/HeroText.astro';
import ProseContent           from '~/components/widgets/ProseContent.astro';
import DocumentosDescargables from '~/components/widgets/DocumentosDescargables.astro';
import CallToAction           from '~/components/widgets/CallToAction.astro';
import PageNav                from '~/components/widgets/PageNav.astro';
import EmptyCollection          from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';
import { pb } from '~/lib/pocketbase';

// -- Interfaces ----------------------------------------------------------------
interface Categoria {
  id: string;
  nombre: string;
  slug: string;
}

interface Producto {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  contenido: string;
  icono: string;
  orden: number;
  publicado: boolean;
  categoria: string;
}

interface Documento {
  id: string;
  nombre: string;
  archivo: string;
  referencia: string;
  tipo: string;
  orden: number;
  collectionId: string;
  collectionName: string;
}

// -- getStaticPaths ------------------------------------------------------------
// Genera una ruta por cada producto publicado.
// Por cada producto se cargan tambien sus documentos descargables.
// Todo el fetching ocurre aqui para no repetir consultas al renderizar.
export const getStaticPaths = (async () => {
  // 1. Obtener todas las categorias (fallo aqui = build falla, correcto)
  const categorias = await pb
    .collection('categorias')
    .getFullList<Categoria>({ sort: 'orden' });

  // 2. Por cada categoria, obtener sus productos publicados
  const paths = await Promise.all(
    categorias.map(async (cat) => {
      let productos: Producto[] = [];

      try {
        productos = await pb
          .collection('productos')
          .getFullList<Producto>({
            filter: `categoria = "${cat.id}" && publicado = true`,
            sort: 'orden',
          });
      } catch {
        // Si falla la carga de productos de esta categoria, se omite
        // sin romper el build completo
        return [];
      }

      // 3. Por cada producto, obtener sus documentos descargables
      return Promise.all(
        productos.map(async (prod) => {
          let documentos: Documento[] = [];
          let dbErrorDocs = false;

          try {
            documentos = await pb
              .collection('documentos')
              .getFullList<Documento>({
                filter: `referencia = "${prod.slug}" && tipo = "producto"`,
                sort: 'orden',
              });
          } catch {
            dbErrorDocs = true;
          }

          return {
            params: {
              categoria: cat.slug,
              producto: prod.slug,
            },
            props: {
              producto: prod,
              categoria: cat,
              documentos,
              dbErrorDocs,
            },
          };
        })
      );
    })
  );

  return paths.flat(2);
}) satisfies GetStaticPaths;

// -- Props --------------------------------------------------------------------
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { producto, categoria, documentos, dbErrorDocs } = Astro.props;

// -- Construccion de URLs de descarga -----------------------------------------
// pb.files.getURL construye la URL local completa del archivo en PocketBase.
const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id:      doc.id,
  nombre:  doc.nombre,
  archivo: doc.archivo,
  url:     pb.files.getURL(doc, doc.archivo),
  orden:   doc.orden,
}));

// -- Metadata SEO -------------------------------------------------------------
const metadata = {
  title:       `${producto.nombre} - BPA Santiago de Cuba`,
  description: producto.descripcion,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 - HeroText -----------------------------------------------------
      Nombre del producto como titulo principal.
      Tagline = nombre de la categoria para contextualizar la ubicacion.
      Sin subtitle: el contenido del campo `contenido` habla por si mismo.
  --------------------------------------------------------------------------- -->
  <HeroText
    tagline={categoria.nombre}
    title={producto.nombre}
  />

  <!-- BLOQUE 2 - ProseContent -------------------------------------------------
      Renderiza el HTML del campo `contenido` con Tailwind Typography.
      El administrador escribe en el campo Plain Text de PocketBase con
      HTML generado por IA — prose aplica el estilo automaticamente.
      Si hubo error de conexion en build time -> DatabaseError.
  --------------------------------------------------------------------------- -->
  {producto.contenido
    ? <ProseContent contenido={producto.contenido} />
    : <EmptyCollection 
        coleccion="productos" 
        mensaje="Aún no hay información detallada acerca de este servicio."
        icono="tabler:info-circle"
      />
  }

  <!-- BLOQUE 3 - DocumentosDescargables ---------------------------------------
      Grid de archivos asociados a este producto (planillas, guias, etc.).
      - Si dbErrorDocs=true -> aviso ambar discreto (no bloquea la pagina).
      - Si no hay documentos -> el componente no renderiza nada (silencioso).
      - Si hay documentos    -> grid de tarjetas con boton de descarga.
  --------------------------------------------------------------------------- -->
  <DocumentosDescargables
    documentos={documentosConUrl}
    error={dbErrorDocs}
    titulo="Documentos relacionados"
  />

  <!-- BLOQUE 4 - CallToAction -------------------------------------------------
      Cierre institucional consistente con el resto del modulo.
  --------------------------------------------------------------------------- -->
  <CallToAction
    title="¿Necesita más información sobre este servicio?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para asesorarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text:    'Contáctenos',
        href:    '/contacto',
        icon:    'tabler:headset',
      },
    ]}
  />

  <!-- NAVEGACION - PageNav ----------------------------------------------------
      Boton izquierdo: volver a la pagina de la categoria padre.
      La URL y el texto se construyen dinamicamente con los datos de la categoria.
  --------------------------------------------------------------------------- -->
  <PageNav
    prev={{
      text: `Volver a ${categoria.nombre}`,
      href: `/productos/${categoria.slug}`,
    }}
  />

</Layout>
