---
/**
 * @pagina  src/pages/productos/[categoria]/[producto].astro
 * @ruta    /productos/[categoria]/[producto]
 * @ejemplo /productos/banca-personal/depositos-plazo-fijo
 *
 * @descripcion
 * Página dinámica generada en build time para cada producto o servicio.
 * getStaticPaths consulta todas las categorías y sus productos publicados,
 * generando una ruta por cada combinación categoria/producto.
 *
 * El campo `contenido` (Rich Text de PocketBase) se renderiza con Tailwind
 * Typography (prose). El administrador escribe con el editor visual del panel
 * de PocketBase — encabezados, listas, negritas, etc. — y prose aplica el
 * estilo tipográfico automáticamente. No se necesita escribir clases CSS en
 * el contenido.
 *
 * Widgets utilizados:
 *   - HeroText      → Nombre del producto como título (sin subtitle)
 *                     Tagline = nombre de la categoría padre
 *   - prose div     → Cuerpo de contenido enriquecido desde PocketBase
 *   - CallToAction  → Cierre institucional
 *   - PageNav       → ← Volver a la categoría padre
 *
 * Componentes de estado:
 *   - DatabaseError   → Fallo de conexión con PocketBase en build time
 *
 * Colecciones PocketBase:
 *   `categorias` → id, nombre, slug
 *   `productos`  → id, nombre, slug, categoria (Relation → categorias),
 *                  descripcion_corta, contenido (Rich Text), icono,
 *                  orden, publicado
 */

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import DatabaseError from '~/components/ui/DatabaseError.astro';
import { pb } from '~/lib/pocketbase';

// ─── TIPOS ────────────────────────────────────────────────────────────────────
interface Categoria {
  id: string;
  nombre: string;
  slug: string;
}

interface Producto {
  id: string;
  nombre: string;
  slug: string;
  descripcion_corta: string;
  contenido: string;   // HTML generado por el editor Rich Text de PocketBase
  icono: string;
  orden: number;
  publicado: boolean;
  categoria: string;   // ID del registro relacionado en `categorias`
}

// ─── getStaticPaths ───────────────────────────────────────────────────────────
// Genera una ruta por cada producto publicado de cada categoría.
// Toda la lógica de carga ocurre aquí para no repetir consultas al renderizar.
export const getStaticPaths = (async () => {
  // 1. Obtener todas las categorías
  const categorias = await pb
    .collection('categorias')
    .getFullList<Categoria>({ sort: 'orden' });

  // 2. Para cada categoría, obtener sus productos publicados y generar rutas
  const paths = await Promise.all(
    categorias.map(async (cat) => {
      let productos: Producto[] = [];
      let dbError = false;

      try {
        productos = await pb
          .collection('productos')
          .getFullList<Producto>({
            filter: `categoria = "${cat.id}" && publicado = true`,
            sort: 'orden',
          });
      } catch {
        dbError = true;
      }

      // Una ruta por cada producto de esta categoría
      return productos.map((prod) => ({
        params: {
          categoria: cat.slug,
          producto: prod.slug,
        },
        props: {
          producto: prod,
          categoria: cat,
          dbError,
        },
      }));
    })
  );

  // flatMap porque cada categoría devuelve un array de rutas
  return paths.flat();
}) satisfies GetStaticPaths;

// ─── PROPS ────────────────────────────────────────────────────────────────────
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { producto, categoria, dbError } = Astro.props;

// ─── METADATA SEO ─────────────────────────────────────────────────────────────
const metadata = {
  title: `${producto.nombre} — BPA Santiago de Cuba`,
  description: producto.descripcion_corta,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ─────────────────────────────────────────────────────
      Nombre del producto como título principal.
      Tagline muestra la categoría padre para contextualizar la ubicación.
      Sin subtitle — el contenido habla por sí mismo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={categoria.nombre}
    title={producto.nombre}
  />

  <!-- BLOQUE 2 · Contenido enriquecido ────────────────────────────────────────
      El campo `contenido` es HTML generado por el editor Rich Text de
      PocketBase. Tailwind Typography (prose) aplica estilo tipográfico
      automático a todos los elementos HTML: h2, h3, p, ul, ol, strong, etc.
  ─────────────────────────────────────────────────────────────────────────── -->
  {dbError ? (
    <DatabaseError coleccion="productos" />
  ) : (
    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div
          class="
            prose prose-lg max-w-none
            dark:prose-invert
            dark:prose-headings:text-slate-300
            prose-headings:font-heading
            prose-headings:leading-tighter
            prose-headings:tracking-tighter
            prose-headings:font-bold
            prose-a:text-primary
            dark:prose-a:text-blue-400
            prose-img:rounded-md
            prose-img:shadow-lg
            prose-li:my-0
          "
          set:html={producto.contenido}
        ></div>
      </div>
    </section>
  )}

  <!-- BLOQUE 3 · CallToAction ─────────────────────────────────────────────────
      Cierre institucional consistente con el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Necesita más información sobre este servicio?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para asesorarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text: 'Contáctenos',
        href: '/contacto',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- NAVEGACIÓN · PageNav ────────────────────────────────────────────────────
      Botón izquierdo: volver a la página de la categoría padre.
      La URL se construye dinámicamente con el slug de la categoría.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{
      text: `Volver a ${categoria.nombre}`,
      href: `/productos/${categoria.slug}`,
    }}
  />

</Layout>
