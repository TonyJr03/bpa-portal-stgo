---
/**
 * @pagina     Trámite — Detalle
 * @ruta       /tramites/[tramite]   (ej: /tramites/tarjeta-debito)
 * @descripcion Página de detalle de un trámite individual. Muestra el contenido
 *              completo del proceso (pasos, requisitos, beneficios) renderizado
 *              desde Markdown almacenado en PocketBase, más un bloque de descarga
 *              de documentos asociados al trámite (planillas, guías, formularios).
 *
 * El campo `contenido` almacena texto en formato Markdown (Plain Text en PocketBase).
 * Se convierte a HTML con `marked.parse()` en build time — sin JS en el cliente.
 *
 * @colecciones
 *   - tramites    →  getFullList, filtro: publicado = true  (genera las rutas)
 *   - documentos  →  getFullList, filtro: referencia = "{slug}" && tipo = "tramite"
 *                    orden: orden ASC  (documentos descargables del trámite)
 *
 * @patron  getStaticPaths: TODO el fetching ocurre aquí. Cero consultas al renderizar.
 */

// ── Imports ────────────────────────────────────────────────────────────────────
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { marked }               from 'marked';
import Layout                   from '~/layouts/PageLayout.astro';
import HeroText                 from '~/components/widgets/HeroText.astro';
import CallToAction             from '~/components/widgets/CallToAction.astro';
import PageNav                  from '~/components/widgets/PageNav.astro';
import ProseContent             from '~/components/sections/ProseContent.astro';
import DocumentosDescargables   from '~/components/widgets/DocumentosDescargables.astro';
import EmptyCollection          from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';
import { pb, fetchParaBuild }   from '~/lib/pocketbase';

// ── Interfaces ────────────────────────────────────────────────────────────────
interface Tramite {
  id: string;
  nombre: string;
  slug: string;
  descripcion: string;
  contenido: string;
  icono: string;
  orden: number;
  publicado: boolean;
}

interface Documento {
  id: string;
  nombre: string;
  archivo: string;
  referencia: string;
  tipo: string;
  orden: number;
  collectionId: string;
  collectionName: string;
}

// ── getStaticPaths ─────────────────────────────────────────────────────────────
export const getStaticPaths = (async () => {
  // ✅ fetchParaBuild envuelve el fetch en try/catch.
  // Si PocketBase no está disponible (ej: GitHub Actions / CI), devuelve []
  // y el build continúa generando 0 rutas en lugar de explotar con ECONNREFUSED.
  const tramites = await fetchParaBuild<Tramite>(
    () => pb.collection('tramites').getFullList<Tramite>({
      filter: 'publicado = true',
      sort:   'orden',
    }),
    'tramites'
  );

  const paths = await Promise.all(
    tramites.map(async (tramite) => {
      let documentos: Documento[] = [];
      let dbErrorDocs = false;

      try {
        documentos = await pb.collection('documentos').getFullList<Documento>({
          filter: `referencia = "${tramite.slug}" && tipo = "tramite"`,
          sort:   'orden',
        });
      } catch (err) {
        console.error(`[BPA] Error cargando documentos para "${tramite.slug}":`, err);
        dbErrorDocs = true;
      }

      return {
        params: { tramite: tramite.slug },
        props:  { tramite, documentos, dbErrorDocs },
      };
    })
  );

  return paths;
}) satisfies GetStaticPaths;

// ── Props ─────────────────────────────────────────────────────────────────────
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { tramite, documentos, dbErrorDocs } = Astro.props;

// ── Conversión Markdown → HTML ────────────────────────────────────────────────
// marked.parse() es síncrono y se ejecuta en build time — cero coste en runtime.
const contenidoHtml = tramite.contenido?.trim()
  ? marked.parse(tramite.contenido) as string
  : '';

// ── Construcción de URLs de descarga ──────────────────────────────────────────
const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id:      doc.id,
  nombre:  doc.nombre,
  archivo: doc.archivo,
  url:     pb.files.getURL(doc, doc.archivo),
  orden:   doc.orden,
}));

// ── Metadata SEO ──────────────────────────────────────────────────────────────
const metadata = {
  title:       `${tramite.nombre} — Trámites BPA Santiago de Cuba`,
  description: tramite.descripcion,
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline = sección padre "Trámites". Title = nombre del trámite.
      Sin subtitle: el contenido prose aporta el contexto completo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline="Trámites"
    title={tramite.nombre}
  />

  <!-- BLOQUE 2 · ProseContent / EmptyCollection ───────────────────────────────
      Si el campo `contenido` tiene datos → convierte Markdown a HTML y renderiza
      con Tailwind Typography. Si está vacío → EmptyCollection avisa al usuario.
  ─────────────────────────────────────────────────────────────────────────── -->
  {contenidoHtml
    ? <ProseContent contenido={contenidoHtml} />
    : <EmptyCollection
        coleccion="tramites"
        mensaje="La información detallada sobre este trámite no está disponible todavía."
        icono="tabler:info-circle"
      />
  }

  <!-- BLOQUE 3 · DocumentosDescargables ───────────────────────────────────────
      Muestra el grid de archivos descargables asociados a este trámite.
      - Si error=true  → aviso ámbar discreto (no bloquea la página).
      - Si array vacío → el componente no renderiza nada (silencioso).
      - Si hay docs    → grid de tarjetas con botón de descarga.
  ─────────────────────────────────────────────────────────────────────────── -->
  <DocumentosDescargables
    documentos={documentosConUrl}
    error={dbErrorDocs}
    titulo="Documentos del trámite"
  />

  <!-- BLOQUE 4 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional. Invita a contactar si quedan dudas sobre el trámite.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Tiene alguna duda sobre este trámite?"
    subtitle="Nuestro equipo puede orientarle sobre los requisitos o el estado de su gestión."
    actions={[
      {
        variant: 'primary',
        text:    'Contáctenos',
        href:    '/contacto',
        icon:    'tabler:message',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Navegación contextual: regresa al listado de trámites.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: 'Volver a Trámites', href: '/tramites' }}
  />

</Layout>
