---
/**
 * @pagina  src/pages/[lang]/sobre-nosotros/index.astro
 * @ruta    es/sobre-nosotros
 *          en/sobre-nosotros
 *
 * @descripcion
 * Página de entrada al módulo "Sobre Nosotros" del portal institucional
 * del BPA Santiago de Cuba. Presenta las cuatro subsecciones del módulo
 * con distinto peso visual según su relevancia institucional:
 *
 *   - Misión y Visión: bloques Content completos con SVG y texto de
 *     presentación — son los textos fundacionales del banco, merecen
 *     el mayor espacio.
 *
 *   - Historia y Nuestra Red: dos tarjetas Features2 — son secciones
 *     importantes pero de acceso, no requieren el mismo desarrollo aquí.
 *
 * Estructura (Opción B acordada):
 *   BLOQUE 1 · HeroText   → título del módulo + subtítulo institucional
 *   BLOQUE 2 · Content    → Misión · SvgMision · bg-bpa-alt
 *   BLOQUE 3 · Content    → Visión · SvgVision · isReversed
 *   BLOQUE 4 · Features2  → Historia + Nuestra Red (columns=2)
 *                            fondo bg-bpa-alt
 *   BLOQUE 5 · PageNav    → sin prev (es el índice) / sin next (el usuario
 *                            avanza por las tarjetas y los botones de cada bloque)
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado.
 */

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import SvgMision from '~/components/icons/SvgMision.astro';
import SvgVision from '~/components/icons/SvgVision.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('about.hero.title')} — BPA Santiago de Cuba`,
  description: t('about.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Entrada al módulo. 
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText title={t('about.hero.title')} subtitle={t('about.hero.subtitle')} />

  <!-- BLOQUE 2 · Content — Misión ──────────────────────────────────────────────
      SVG a la derecha, texto a la izquierda (sin isReversed).
  ─────────────────────────────────────────────────────────────────────────── -->
  <Content
    tagline={t('about.mission.tagline')}
    title={t('about.mission.title')}
    content={`<p>${t('about.mission.content.p1')}</p>`}
    items={[
      {
        title: t('about.mission.readMore'),
        description: t('about.mission.readMore.desc'),
        icon: 'tabler:arrow-right',
        callToAction: {
          variant: 'link',
          text: t('about.mission.readMore.link'),
          href: p('sobre-nosotros/mision'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  >
    <SvgMision slot="image" />
  </Content>

  <!-- BLOQUE 3 · Content — Visión ──────────────────────────────────────────────
      isReversed=true: SVG a la izquierda, texto a la derecha.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Content
    isReversed
    tagline={t('about.vision.tagline')}
    title={t('about.vision.title')}
    content={`<p>${t('about.vision.content.p1')}</p>`}
    items={[
      {
        title: t('about.vision.readMore'),
        description: t('about.vision.readMore.desc'),
        icon: 'tabler:arrow-right',
        callToAction: {
          variant: 'link',
          text: t('about.vision.readMore.link'),
          href: p('sobre-nosotros/vision'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  >
    <SvgVision slot="image" />
  </Content>

  <!-- BLOQUE 4 · Features2 — Historia + Nuestra Red ───────────────────────────
      Dos tarjetas de acceso rápido para las secciones de menor peso narrativo
      en esta página de presentación.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    tagline={t('about.more.tagline')}
    columns={2}
    items={[
      {
        title: t('about.history.title'),
        description: t('about.history.desc'),
        icon: 'tabler:timeline',
        callToAction: {
          variant: 'link',
          text: t('about.history.link'),
          href: p('sobre-nosotros/historia'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('about.network.title'),
        description: t('about.network.desc'),
        icon: 'tabler:map-pins',
        callToAction: {
          variant: 'link',
          text: t('about.network.link'),
          href: p('sobre-nosotros/nuestra-red'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ─────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('about.nav.back'), href: p('') }} />
</Layout>
