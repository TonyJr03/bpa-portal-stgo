---
/**
 * @pagina  src/pages/[lang]/sobre-nosotros/mision.astro
 * @ruta    es/sobre-nosotros/mision
 *          en/sobre-nosotros/mision
 *
 * @descripcion
 * Página estática institucional con la Misión oficial del BPA Santiago de Cuba.
 * Estructura de presentación usando widgets nativos de AstroWind:
 *
 *   BLOQUE 2 · Content    → Texto oficial de la Misión (§2 del documento).
 *                           SVG institucional inyectado vía slot `image`.
 *                           Fondo azul suave (bg-bpa-alt).
 *
 *   BLOQUE 3 · Features3  → 4 principios clave a ancho completo (2 columnas).
 *                           isAfterContent=true elimina el padding superior para
 *                           que visualmente sea continuo con el bloque Content.
 *                           Mismo fondo bg-bpa-alt → sección unificada visualmente.
 *
 *   BLOQUE 4 · Features3  → 6 funciones principales del banco (3 columnas),
 *                           orientadas al cliente, extraídas del §4 del documento.
 *                           Fondo blanco / sin bg → alternancia visual clara.
 *
 * Nota sobre el SVG: se mantiene en src/components/icons/SvgMision.astro para
 * no contaminar esta página con ~60 líneas de markup. Se pasa como slot `image`
 * al widget Content, que internamente lo renderiza con Astro.slots.render('image').
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (texto oficial estático).
 */

import type { GetStaticPaths } from 'astro';
import Layout    from '~/layouts/PageLayout.astro';
import HeroText  from '~/components/widgets/HeroText.astro';
import Content   from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import PageNav   from '~/components/widgets/PageNav.astro';
import SvgMision from '~/components/icons/SvgMision.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('about.mission.hero.title')} — BPA Santiago de Cuba`,
  description: t('about.mission.content.p1').replace(/<[^>]*>/g, ''),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('about.mission.hero.tagline')}
    title={t('about.mission.hero.title')}
  />

  <!-- BLOQUE 2 · Content ───────────────────────────────────────────────────────
      Columna izquierda: texto oficial íntegro de la Misión (§2 del documento).
      Columna derecha:  SvgMision inyectado como slot `image`.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Content
    content={`
      <p>${t('about.mission.content.p1')}</p>
      <p style="margin-top:1rem">${t('about.mission.content.p2')}</p>
    `}
  >
    <SvgMision slot="image" />
  </Content>

  <!-- BLOQUE 3 · Features3 — Principios (ancho completo) ────────────────────── -->
  <Features3
    columns={4}
    isAfterContent={true}
    items={[
      {
        title:       t('about.mission.p1.title'),
        description: t('about.mission.p1.desc'),
        icon:        'tabler:building-bank',
      },
      {
        title:       t('about.mission.p2.title'),
        description: t('about.mission.p2.desc'),
        icon:        'tabler:users',
      },
      {
        title:       t('about.mission.p3.title'),
        description: t('about.mission.p3.desc'),
        icon:        'tabler:device-laptop',
      },
      {
        title:       t('about.mission.p4.title'),
        description: t('about.mission.p4.desc'),
        icon:        'tabler:heart-handshake',
      },
    ]}
  />

  <!-- BLOQUE 4 · Features3 — Funciones ──────────────────────────────────────── -->
  <Features2
    tagline={t('about.mission.functions.tagline')}
    title={t('about.mission.functions.title')}
    subtitle={t('about.mission.functions.subtitle')}
    columns={3}
    items={[
      {
        title:       t('about.mission.f1.title'),
        description: t('about.mission.f1.desc'),
        icon:        'tabler:building-bank',
      },
      {
        title:       t('about.mission.f2.title'),
        description: t('about.mission.f2.desc'),
        icon:        'tabler:cash-banknote',
      },
      {
        title:       t('about.mission.f3.title'),
        description: t('about.mission.f3.desc'),
        icon:        'tabler:arrows-exchange',
      },
      {
        title:       t('about.mission.f4.title'),
        description: t('about.mission.f4.desc'),
        icon:        'tabler:credit-card',
      },
      {
        title:       t('about.mission.f5.title'),
        description: t('about.mission.f5.desc'),
        icon:        'tabler:certificate',
      },
      {
        title:       t('about.mission.f6.title'),
        description: t('about.mission.f6.desc'),
        icon:        'tabler:chart-bar',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Izquierda: regresa al inicio del portal.
      Derecha:   avanza a la Visión (flujo natural de lectura institucional).
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: t('about.mission.nav.prev'), href: p('')             }}
    next={{ text: t('about.mission.nav.next'), href: p('sobre-nosotros/vision') }}
  />

</Layout>
