---
/**
 * @pagina   src/pages/[lang]/sobre-nosotros/nuestra-red/sucursales.astro
 * @ruta     /es/sobre-nosotros/nuestra-red/sucursales
 *           /en/sobre-nosotros/nuestra-red/sucursales
 *
 * @descripcion
 * Página estática informativa sobre los tipos de oficinas bancarias del BPA
 * en Santiago de Cuba: sucursales grandes, sucursales medianas/pequeñas,
 * cajas de ahorro y cajeros automáticos.
 *
 * El contenido está extraído y reescrito del documento oficial
 * "02 - Estructura y Funciones" (Título III - Sucursales y Cajas de Ahorro),
 * adaptado a lenguaje ciudadano.
 *
 * NO muestra el mapa ni la lista de ubicaciones — eso corresponde a la
 * herramienta interactiva en /herramientas/mapa. Al final de la página
 * un CallToAction enlaza a esa sección (Opción A: el enlace existe aunque
 * la página de destino aún no esté implementada).
 *
 * Estructura:
 *   BLOQUE 1 · HeroText   → tagline "Nuestra Red" + title + subtitle
 *   BLOQUE 2 · Content    → qué es una sucursal, qué servicios ofrece
 *                            + SvgSucursales · isReversed
 *   BLOQUE 3 · Features3  → 3 tipos de oficina (columns=3)
 *                            isAfterContent → continuidad con bloque 2
 *   BLOQUE 4 · Content    → qué es un ATM, cómo usarlo
 *                            + SvgATM · fondo bg-bpa-alt
 *   BLOQUE 5 · CallToAction → Ver todas las oficinas en el mapa
 *   BLOQUE 6 · PageNav    → prev: Dirección Provincial / next: Canales
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (información fija).
 */

import type { GetStaticPaths } from 'astro';
import Layout        from '~/layouts/PageLayout.astro';
import HeroText      from '~/components/widgets/HeroText.astro';
import Content       from '~/components/widgets/Content.astro';
import Features3     from '~/components/widgets/Features3.astro';
import CallToAction  from '~/components/widgets/CallToAction.astro';
import PageNav       from '~/components/widgets/PageNav.astro';
import SvgSucursales from '~/components/icons/SvgSucursales.astro';
import SvgATM        from '~/components/icons/SvgATM.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('network.offices.hero.title')} — BPA Santiago de Cuba`,
  description: t('network.offices.hero.subtitle'),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('network.offices.hero.tagline')}
    title={t('network.offices.hero.title')}
    subtitle={t('network.offices.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Content — Qué es una sucursal ───────────────────────────────── -->
  <Content
    isReversed
    title={t('network.offices.content.title')}
    content={`
      <p>${t('network.offices.content.p1')}</p>
      <p style="margin-top:1rem">${t('network.offices.content.p2')}</p>
      <p style="margin-top:1rem">${t('network.offices.content.p3')}</p>
    `}
  >
    <SvgSucursales slot="image" />
  </Content>

  <!-- BLOQUE 3 · Features3 — Tipos de oficina ──────────────────────────────────
      Tres columnas: una por cada tipo de oficina bancaria.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features3
    tagline={t('network.offices.types.tagline')}
    title={t('network.offices.types.title')}
    subtitle={t('network.offices.types.subtitle')}
    columns={3}
    isAfterContent={true}
    items={[
      {
        title:       t('network.offices.t1.title'),
        description: t('network.offices.t1.desc'),
        icon:        'tabler:building-bank',
      },
      {
        title:       t('network.offices.t2.title'),
        description: t('network.offices.t2.desc'),
        icon:        'tabler:building',
      },
      {
        title:       t('network.offices.t3.title'),
        description: t('network.offices.t3.desc'),
        icon:        'tabler:pig-money',
      },
    ]}
  />

  <!-- BLOQUE 4 · Content — Cajeros Automáticos ─────────────────────────────────
      Sección dedicada a los ATM: qué son, qué permiten hacer, recomendaciones.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Content
    title={t('network.offices.atm.title')}
    content={`
      <p>${t('network.offices.atm.p1')}</p>
      <p style="margin-top:1rem">${t('network.offices.atm.p2')}</p>
      <p style="margin-top:1rem">${t('network.offices.atm.p3')}</p>
      <p style="margin-top:1.5rem">${t('network.offices.atm.p4')}</p>
    `}
  >
    <SvgATM slot="image" />
  </Content>

  <!-- BLOQUE 5 · CallToAction — Enlace al mapa ─────────────────────────────────
      Cierre natural de la página: invita al usuario a localizar la oficina
      más cercana en el mapa interactivo de Herramientas.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('network.offices.cta.title')}
    subtitle={t('network.offices.cta.subtitle')}
    actions={[{
      variant: 'primary',
      text:    t('network.offices.cta.button'),
      href:    p('herramientas/mapa'),
      icon:    'tabler:map-2',
    }]}
  />

  <!-- BLOQUE 6 · PageNav ───────────────────────────────────────────────────────
      Izquierda: regresa a Dirección Provincial (sección anterior).
      Derecha:   avanza a Canales de Atención (siguiente subsección).
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('network.offices.nav.prev'), href: p('sobre-nosotros/nuestra-red') }} />

</Layout>
