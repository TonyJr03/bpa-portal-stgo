---
/**
 * @pagina   src/pages/[lang]/sobre-nosotros/nuestra-red/direccion-provincial.astro
 * @ruta     /es/sobre-nosotros/nuestra-red/direccion-provincial
 *           /en/sobre-nosotros/nuestra-red/direccion-provincial
 *
 * @descripcion
 * Página estática institucional de la Dirección Provincial del BPA en
 * Santiago de Cuba. Presenta su rol territorial, las cuatro áreas de
 * servicio relevantes para el ciudadano y los datos de contacto de la sede.
 *
 * El contenido se extrae y reescribe del documento oficial
 * "02 - Estructura y Funciones" (Título II - Direcciones Provinciales),
 * adaptado a lenguaje ciudadano — sin tecnicismos internos.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText  → tagline "Nuestra Red" + title
 *   BLOQUE 2 · Content   → párrafo institucional + SvgDireccion
 *                           fondo bg-bpa-alt
 *   BLOQUE 3 · Features2 → 4 áreas de servicio al cliente (columns=2)
 *                           isAfterContent para continuidad visual
 *   BLOQUE 4 · Features2 → datos de contacto de la sede (columns=2)
 *   BLOQUE 5 · PageNav   → prev: Nuestra Red / next: Sucursales y Oficinas
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (datos oficiales fijos).
 *
 * NOTA PARA EL ADMINISTRADOR:
 * Los datos de contacto del BLOQUE 4 (teléfono, correo, dirección, horario)
 * están hardcodeados con valores de ejemplo marcados con [COMPLETAR].
 * Sustitúyalos por los datos reales antes del despliegue en producción.
 */

import type { GetStaticPaths } from 'astro';
import Layout       from '~/layouts/PageLayout.astro';
import HeroText     from '~/components/widgets/HeroText.astro';
import Content      from '~/components/widgets/Content.astro';
import Features     from '~/components/widgets/Features.astro';
import Features2    from '~/components/widgets/Features2.astro';
import PageNav      from '~/components/widgets/PageNav.astro';
import SvgDireccion from '~/components/icons/SvgDireccion.astro';

import { LANGS, useTranslations, useLocalTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);
const tl = useLocalTranslations(lang, {
  es: {
    address:     'Dirección',
    phones:      'Teléfonos',
    email:       'Correo Institucional',
    hours:       'Horario de Atención',
    hoursDetail: '[COMPLETAR: Lunes a Viernes · 8:00 am – 4:00 pm<br/>Sábados · 8:00 am – 12:00 m]',
  },
  en: {
    address:     'Address',
    phones:      'Phone Numbers',
    email:       'Institutional Email',
    hours:       'Service Hours',
    hoursDetail: '[COMPLETAR: Monday to Friday · 8:00 am – 4:00 pm<br/>Saturdays · 8:00 am – 12:00 noon]',
  },
});

const metadata = {
  title: `${t('network.provincial.title')} — BPA Santiago de Cuba`,
  description: t('network.provincial.content.p1').replace(/<[^>]*>/g, ''),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('network.provincial.tagline')}
    title={t('network.provincial.title')}
  />

  <!-- BLOQUE 2 · Content ───────────────────────────────────────────────────────
      Presentación institucional de la Dirección Provincial.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Content
    content={`
      <p>${t('network.provincial.content.p1')}</p>
      <p style="margin-top:1rem">${t('network.provincial.content.p2')}</p>
      <p style="margin-top:1rem">${t('network.provincial.content.p3')}</p>
    `}
  >
    <SvgDireccion slot="image" />
  </Content>

  <!-- BLOQUE 3 · Features2 — Áreas de servicio al cliente ─────────────────────
      Las cuatro áreas de la Dirección Provincial con impacto directo
      en la atención ciudadana, extraídas del documento oficial y reescritas
      en lenguaje accesible.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    tagline={t('network.provincial.areas.tagline')}
    title={t('network.provincial.areas.title')}
    subtitle={t('network.provincial.areas.subtitle')}
    columns={2}
    items={[
      {
        title:       t('network.provincial.a1.title'),
        description: t('network.provincial.a1.desc'),
        icon:        'tabler:user-dollar',
      },
      {
        title:       t('network.provincial.a2.title'),
        description: t('network.provincial.a2.desc'),
        icon:        'tabler:briefcase',
      },
      {
        title:       t('network.provincial.a3.title'),
        description: t('network.provincial.a3.desc'),
        icon:        'tabler:message-circle',
      },
      {
        title:       t('network.provincial.a4.title'),
        description: t('network.provincial.a4.desc'),
        icon:        'tabler:coins',
      },
    ]}
  />

  <!-- BLOQUE 4 · Features2 — Datos de contacto ────────────────────────────────
      Información de contacto de la sede de la Dirección Provincial.
      NOTA: Los valores marcados con [COMPLETAR] deben ser sustituidos
      por los datos reales antes del despliegue en producción.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features
    tagline={t('network.provincial.contact.tagline')}
    title={t('network.provincial.contact.title')}
    subtitle={t('network.provincial.contact.subtitle')}
    columns={2}
    items={[
      {
        title:       tl('address'),
        description: '[COMPLETAR: Calle, número, entre calles, municipio Santiago de Cuba]',
        icon:        'tabler:map-pin',
      },
      {
        title:       tl('phones'),
        description: '[COMPLETAR: (022) XXXXX — Recepción<br/>(022) XXXXX — Atención al Cliente]',
        icon:        'tabler:phone',
      },
      {
        title:       tl('email'),
        description: '[COMPLETAR: atencion@bpa.scu.cu]',
        icon:        'tabler:mail',
      },
      {
        title:       tl('hours'),
        description: tl('hoursDetail'),
        icon:        'tabler:clock',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Izquierda: regresa al índice del módulo Nuestra Red.
      Derecha:   avanza a la siguiente subsección (Sucursales y Oficinas).
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('network.provincial.nav.prev'), href: p('sobre-nosotros/nuestra-red') }} />

</Layout>
