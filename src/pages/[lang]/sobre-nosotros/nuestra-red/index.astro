---
/**
 * @pagina   src/pages/[lang]/sobre-nosotros/nuestra-red/index.astro
 * @ruta     /es/sobre-nosotros/nuestra-red  |  /en/sobre-nosotros/nuestra-red
 *
 * @descripcion
 * Página de entrada al módulo "Nuestra Red" del portal institucional del BPA
 * Santiago de Cuba. Presenta las tres subsecciones del módulo como tarjetas
 * de acceso rápido, acompañadas de un párrafo introductorio sobre la presencia
 * territorial del banco en la provincia.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText  → título, subtítulo institucional
 *   BLOQUE 2 · Features2 → 3 tarjetas (Dirección Provincial,
 *                           Sucursales y Oficinas, Canales de Atención)
 *   BLOQUE 3 · PageNav   → prev: Sobre Nosotros (último paso)
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (secciones fijas).
 */

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('network.hero.title')} — BPA Santiago de Cuba`,
  description: t('network.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText title={t('network.hero.title')} subtitle={t('network.hero.subtitle')} />

  <!-- BLOQUE 2 · Features2 — Las tres subsecciones ────────────────────────────
      Tres tarjetas hardcodeadas con icono, título, descripción y enlace.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    tagline={t('network.explore.tagline')}
    columns={3}
    items={[
      {
        title: t('network.branch.title'),
        description: t('network.branch.desc'),
        icon: 'tabler:building-bank',
        callToAction: {
          variant: 'link',
          text: t('network.branch.link'),
          href: p('sobre-nosotros/nuestra-red/direccion-provincial'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('network.offices.title'),
        description: t('network.offices.desc'),
        icon: 'tabler:map-pins',
        callToAction: {
          variant: 'link',
          text: t('network.offices.link'),
          href: p('sobre-nosotros/nuestra-red/sucursales'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('network.channels.title'),
        description: t('network.channels.desc'),
        icon: 'tabler:headset',
        callToAction: {
          variant: 'link',
          text: t('network.channels.link'),
          href: p('sobre-nosotros/nuestra-red/canales-de-atencion'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  />

  <!-- BLOQUE 3 · PageNav ───────────────────────────────────────────────────────
      El botón "prev" permite volver a la última página del módulo anterior.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('network.nav.prev'), href: p('sobre-nosotros') }} />
</Layout>
