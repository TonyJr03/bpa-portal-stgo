---
/**
 * @pagina   src/pages/[lang]/sobre-nosotros/nuestra-red/canales-de-atencion.astro
 * @ruta     /es/sobre-nosotros/nuestra-red/canales-de-atencion
 *           /en/sobre-nosotros/nuestra-red/canales-de-atencion
 *
 * @descripcion
 * Página estática que centraliza todos los modos de comunicación del BPA
 * Santiago de Cuba con sus clientes: atención presencial, teléfonos por
 * área, correos institucionales y horarios de servicio.
 * Incluye además el proceso paso a paso para presentar una queja o
 * reclamación, extraído del documento oficial de funciones (rol del
 * Oficial de Salón y Departamento de Comunicación Institucional).
 *
 * Estructura:
 *   BLOQUE 1 · HeroText  → tagline "Nuestra Red" + title + subtitle
 *   BLOQUE 2 · Features2 → 4 canales de atención (columns=2)
 *                           fondo bg-bpa-alt
 *   BLOQUE 3 · Steps     → 4 pasos del proceso de queja/reclamación
 *   BLOQUE 4 · PageNav   → prev: Sucursales y Oficinas (último del módulo)
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado.
 *
 * NOTA PARA EL ADMINISTRADOR:
 * Los campos marcados con [COMPLETAR] en el BLOQUE 2 deben sustituirse
 * por los datos reales antes del despliegue en producción:
 *   - Teléfonos de cada área de la Dirección Provincial
 *   - Correos institucionales por departamento
 *   - Horarios actualizados de sucursales y cajas de ahorro
 */

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations, useLocalTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);
const urlDir = p('sobre-nosotros/nuestra-red/direccion-provincial');
const urlMapa = p('herramientas/mapa');
const c1Desc =
  lang === 'es'
    ? `La vía más completa para cualquier gestión bancaria. Acuda a la sucursal o caja de ahorro más cercana con su carné de identidad. Para trámites que la sucursal no puede resolver directamente, diríjase a la sede de la <a href="${urlDir}" class="text-primary hover:underline">Dirección Provincial</a>. Consulte la ubicación de todas las oficinas en el <a href="${urlMapa}" class="text-primary hover:underline">mapa interactivo</a>.`
    : `The most comprehensive way to handle any banking matter. Visit the nearest branch or savings office with your identity document. For matters the branch cannot resolve directly, go to the <a href="${urlDir}" class="text-primary hover:underline">Provincial Directorate</a>. Find all offices on the <a href="${urlMapa}" class="text-primary hover:underline">interactive map</a>.`;
const tl = useLocalTranslations(lang, {
  es: {
    mainReception: 'Recepción general',
    personalBanking: 'Banca Personal',
    businessBanking: 'Banca de Negocios',
    customerService: 'Atención al Cliente',
    operatCash: 'Operaciones y Efectivo',
    provincialDir: 'Dirección Provincial',
    generalNote: 'Para consultas generales utilice el correo de Atención al Cliente.',
    largeBranches: 'Sucursales grandes y medianas',
    weekdays: 'Lunes a Viernes',
    saturdays: 'Sábados',
    savingsOffices: 'Cajas de Ahorro',
    atm: 'Cajeros Automáticos (ATM)',
    atmHours: '24 horas, todos los días.',
  },
  en: {
    mainReception: 'Main reception',
    personalBanking: 'Personal Banking',
    businessBanking: 'Business Banking',
    customerService: 'Customer Service',
    operatCash: 'Operations & Cash',
    provincialDir: 'Provincial Directorate',
    generalNote: 'For general inquiries use the Customer Service email.',
    largeBranches: 'Large and medium branches',
    weekdays: 'Monday to Friday',
    saturdays: 'Saturdays',
    savingsOffices: 'Savings Offices',
    atm: 'ATMs',
    atmHours: '24 hours, every day.',
  },
});

const metadata = {
  title: `${t('network.channels.hero.title')} — BPA Santiago de Cuba`,
  description: t('network.channels.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('network.channels.hero.tagline')}
    title={t('network.channels.hero.title')}
    subtitle={t('network.channels.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Features2 — Los cuatro canales ────────────────────────────────
      Los campos de contacto real están marcados [COMPLETAR] para facilitar
      la actualización por parte del administrador.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    columns={2}
    items={[
      {
        title: t('network.channels.c1.title'),
        description: c1Desc,
        icon: 'tabler:users',
      },
      {
        title: t('network.channels.c2.title'),
        description:
          tl('mainReception') +
          ': <strong>[COMPLETAR: (022) XXXXX]</strong><br/>' +
          tl('personalBanking') +
          ': <strong>[COMPLETAR: (022) XXXXX]</strong><br/>' +
          tl('businessBanking') +
          ': <strong>[COMPLETAR: (022) XXXXX]</strong><br/>' +
          tl('customerService') +
          ': <strong>[COMPLETAR: (022) XXXXX]</strong><br/>' +
          tl('operatCash') +
          ': <strong>[COMPLETAR: (022) XXXXX]</strong>',
        icon: 'tabler:phone',
      },
      {
        title: t('network.channels.c3.title'),
        description:
          tl('provincialDir') +
          ': <strong>[COMPLETAR: direccion@bpa.scu.cu]</strong><br/>' +
          tl('customerService') +
          ': <strong>[COMPLETAR: atencion@bpa.scu.cu]</strong><br/>' +
          tl('personalBanking') +
          ': <strong>[COMPLETAR: bancapersonal@bpa.scu.cu]</strong><br/>' +
          tl('businessBanking') +
          ': <strong>[COMPLETAR: negocios@bpa.scu.cu]</strong><br/>' +
          tl('generalNote'),
        icon: 'tabler:mail',
      },
      {
        title: t('network.channels.c4.title'),
        description:
          '<strong>' +
          tl('largeBranches') +
          '</strong><br/>' +
          tl('weekdays') +
          ': <strong>[COMPLETAR: 8:00 am – 3:30 pm]</strong><br/>' +
          tl('saturdays') +
          ': <strong>[COMPLETAR: 8:00 am – 12:00 m]</strong><br/><br/>' +
          '<strong>' +
          tl('savingsOffices') +
          '</strong><br/>' +
          tl('weekdays') +
          ': <strong>[COMPLETAR: 8:00 am – 3:00 pm]</strong><br/>' +
          '<strong>' +
          tl('atm') +
          ':</strong> ' +
          tl('atmHours'),
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- BLOQUE 3 · Steps — Proceso de queja o reclamación ───────────────────────
      4 pasos extraídos del rol del Oficial de Salón y del Departamento de
      Comunicación Institucional (documento oficial §Título III - Sucursales
      y §Dirección de Comunicación Institucional).
  ─────────────────────────────────────────────────────────────────────────── -->
  <Steps
    title={t('network.channels.claims.title')}
    subtitle={t('network.channels.claims.subtitle')}
    items={[
      {
        title: t('network.channels.step1.title'),
        description: t('network.channels.step1.desc'),
        icon: 'tabler:user-check',
      },
      {
        title: t('network.channels.step2.title'),
        description: t('network.channels.step2.desc'),
        icon: 'tabler:clipboard-text',
      },
      {
        title: t('network.channels.step3.title'),
        description: t('network.channels.step3.desc'),
        icon: 'tabler:clock-check',
      },
      {
        title: t('network.channels.step4.title'),
        description: t('network.channels.step4.desc'),
        icon: 'tabler:arrow-up-right',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Esta es la última página del módulo Nuestra Red.
      Sin botón "next": el usuario ha completado el recorrido del módulo.
      El botón "prev" regresa a Sucursales y Oficinas.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('network.channels.nav.prev'), href: p('sobre-nosotros/nuestra-red') }} />
</Layout>
