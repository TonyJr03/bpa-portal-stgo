---
/**
 * @pagina  src/pages/[lang]/sobre-nosotros/historia.astro
 * @ruta    es/sobre-nosotros/historia
 *          en/sobre-nosotros/historia
 *
 * @descripcion
 * Página estática institucional con la historia cronológica del BPA Santiago
 * de Cuba. Los hitos están hardcodeados — son fechas y decretos oficiales que
 * no cambian, por lo que no requieren colección en PocketBase.
 *
 * Estructura:
 *   BLOQUE 2 · Steps → Timeline de 6 hitos extraídos de las "Disposiciones
 *                       Generales" (§1) del documento oficial del banco.
 *                       Sin prop `image`: el widget expande el timeline a
 *                       ancho completo (clase `w-full` cuando !image).
 *                       El campo `title` de cada item usa HTML para mostrar
 *                       el año como titular destacado y el decreto como
 *                       subtítulo en texto secundario.
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (datos oficiales fijos).
 */

import type { GetStaticPaths } from 'astro';
import Layout   from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps    from '~/components/widgets/Steps.astro';
import PageNav  from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('about.history.hero.title')} — BPA Santiago de Cuba`,
  description: t('about.history.hero.subtitle'),
};

// Los hitos usan HTML en el title para la jerarquía año / nombre / decreto.
// La estructura es idéntica en ambos idiomas — solo cambia el contenido de t().
const hitos = [1, 2, 3, 4, 5, 6].map((n) => ({
  title: `${t(`about.history.m${n}.year`)} <br />
    <span class="text-xl font-semibold">${t(`about.history.m${n}.title`)}</span><br />
    <span class="text-sm font-normal text-muted">${t(`about.history.m${n}.decree`)}</span>`,
  description: t(`about.history.m${n}.desc`),
  icon: 'tabler:calendar-event',
}));
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline ubica al usuario dentro del módulo "Sobre Nosotros".
      Subtitle ofrece contexto inmediato antes del timeline.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('about.history.hero.tagline')}
    title={t('about.history.hero.title')}
    subtitle={t('about.history.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Steps — Timeline cronológico ──────────────────────────────────
      Seis hitos extraídos del §1 (Disposiciones Generales) del documento oficial.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Steps
    title={t('about.history.milestones.title')}
    subtitle={t('about.history.milestones.subtitle')}
    items={hitos}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BLOQUE 3 · PageNav ───────────────────────────────────────────────────────
      Izquierda: retrocede a Visión (sección anterior del módulo).
      Derecha:   avanza a Directorio (siguiente subsección de Sobre Nosotros).
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: t('about.history.nav.prev'), href: p('sobre-nosotros/vision')     }}
    next={{ text: t('about.history.nav.next'), href: p('sobre-nosotros/nuestra-red') }}
  />

</Layout>
