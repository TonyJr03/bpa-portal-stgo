---
/**
 * @pagina  src/pages/[lang]/sobre-nosotros/vision.astro
 * @ruta    es/sobre-nosotros/vision
 *          en/sobre-nosotros/vision
 *
 * @descripcion
 * Página estática institucional con la Visión oficial del BPA Santiago de Cuba.
 * Estructura de presentación usando widgets nativos de AstroWind:
 *
 *   BLOQUE 2 · Content  → Texto oficial de la Visión (§3 del documento).
 *                         isReversed=true: SVG a la izquierda, texto a la derecha.
 *                         Invierte la composición respecto a mision.astro
 *                         para dar variedad visual al módulo "Sobre Nosotros".
 *                         Fondo azul suave (bg-bpa-alt).
 *
 *   BLOQUE 3 · Steps2   → 4 pilares estratégicos extraídos del texto de la Visión,
 *                         cada uno con icono, título y desarrollo propio.
 *                         Layout: izquierda = encabezado del bloque,
 *                                 derecha  = lista de pilares numerados con icono.
 *                         isAfterContent=true + mismo fondo bg-bpa-alt → continuidad
 *                         visual con el bloque Content superior.
 *
 * Nota sobre el SVG: componente separado en src/components/icons/SvgVision.astro.
 * Se inyecta vía slot `image` en Content (mismo patrón que mision.astro).
 *
 * @colecciones  Ninguna — contenido 100 % hardcodeado (texto oficial estático).
 */

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import SvgVision from '~/components/icons/SvgVision.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('about.vision.hero.title')} — BPA Santiago de Cuba`,
  description: t('about.vision.content.p1').replace(/<[^>]*>/g, ''),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ────────────────────────────────────────────────────── -->
  <HeroText tagline={t('about.vision.hero.tagline')} title={t('about.vision.hero.title')} />

  <!-- BLOQUE 2 · Content ─────────────────────────────────────────────────────── -->
  <Content
    isReversed
    content={`
      <p>${t('about.vision.content.p1')}</p>
      <p style="margin-top:1rem">${t('about.vision.content.p2')}</p>
    `}
  >
    <SvgVision slot="image" />
  </Content>

  <!-- BLOQUE 3 · Steps2 — Pilares estratégicos ───────────────────────────────── -->
  <Steps
    title={t('about.vision.commitments.title')}
    subtitle={t('about.vision.commitments.subtitle')}
    items={[
      {
        title: t('about.vision.c1.title'),
        description: t('about.vision.c1.desc'),
        icon: 'tabler:award',
      },
      {
        title: t('about.vision.c2.title'),
        description: t('about.vision.c2.desc'),
        icon: 'tabler:map-pin',
      },
      {
        title: t('about.vision.c3.title'),
        description: t('about.vision.c3.desc'),
        icon: 'tabler:school',
      },
      {
        title: t('about.vision.c4.title'),
        description: t('about.vision.c4.desc'),
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Izquierda: retrocede a Misión (sección anterior del módulo).
      Derecha:   avanza a Historia (siguiente subsección de Sobre Nosotros).
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: t('about.vision.nav.prev'), href: p('sobre-nosotros/mision') }}
    next={{ text: t('about.vision.nav.next'), href: p('sobre-nosotros/historia') }}
  />
</Layout>
