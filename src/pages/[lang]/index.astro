---
/**
 * @pagina   src/pages/index.astro
 * @ruta     /
 *
 * @descripcion
 *   Página de Inicio del portal institucional del BPA Santiago de Cuba.
 *   Actúa como nodo central de enrutamiento, permitiendo al usuario
 *   alcanzar cualquier sección en máximo dos clics.
 *
 * ─── Estructura top-to-bottom ──────────────────────────────────────────────
 *
 *   BLOQUE 1 · Hero               → CTA principal (SSG estático)
 *   BLOQUE 2 · NoticiasWidget     → Tablón de avisos (isla Vue, runtime)
 *   BLOQUE 3 · AccesoRapidoHome   → 4 herramientas (2 islas Vue, 2 estáticas)
 *   BLOQUE 4 · Productos          → Categorías (src/data/categorias.ts — SSG puro)
 *   BLOQUE 5 · Aplicaciones       → EnZona y Transfermóvil (SSG estático)
 *   BLOQUE 6 · CallToAction       → Contacto rápido
 *
 * ─── Datos estáticos ───────────────────────────────────────────────────────
 *   CATEGORIAS  →  src/data/categorias.ts  (fuente de verdad única)
 *   Las categorías son estructura fija del sitio y NO se consultan en
 *   PocketBase. Si se necesita añadir o renombrar una categoría, ese
 *   es el único archivo a modificar.
 *
 * ─── Islas Vue (runtime, cliente) ──────────────────────────────────────────
 *   TasasMiniWidget.vue      →  colección monedas
 *   CalendarioMiniWidget.vue →  colección eventos
 *   NoticiasRecientes.vue    →  colección noticias
 */

// ── Imports de layout y widgets ────────────────────────────────────────────
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Comunicados from '~/components/sections/Comunicados.astro';
import Noticias from '~/components/sections/Noticias.astro';
import AccesoRapidoHome from '~/components/sections/AccesoRapidoHome.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';
import { CATEGORIAS } from '~/data/categorias';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

// ── Items para el componente Features2 (Bloque 4) ─────────────────────────
const items = CATEGORIAS.map((cat) => ({
  title: t(`cat.${cat.slug}.nombre`),
  description: t(`cat.${cat.slug}.desc`),
  icon: `tabler:${cat.icono}`,
  callToAction: {
    variant: 'link' as const,
    text: t('products.view'),
    href: p(`productos/${cat.slug}`),
    icon: 'tabler:arrow-right',
  },
}));

// ── Metadata SEO ───────────────────────────────────────────────────────────
const metadata = {
  title: `${t('home.hero.title').replace(/<[^>]*>/g, '')} — BPA Santiago de Cuba`,
  ignoreTitleTemplate: true,
  description: t('home.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 1 · HERO — CTA Principal
      ─────────────────────────────────────────────────────────────────────
      El hero es 100 % estático. Sin imagen externa (restricción air-gapped).
      Dos botones: acción primaria "Realizar un Trámite" y secundaria
      "Explorar Productos".
  ══════════════════════════════════════════════════════════════════════════ -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: t('home.hero.cta.primary'),
        href: p('/tramites'),
        icon: 'tabler:file-description',
      },
      {
        variant: 'secondary',
        text: t('home.hero.cta.secondary'),
        href: p('/productos'),
        icon: 'tabler:building-bank',
      },
    ]}
  >
    <Fragment slot="title" set:html={t('home.hero.title')} />

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <strong>{t('home.hero.tagline')}</strong><br />
        {t('home.hero.subtitle')}
      </span>
      <span class="sm:hidden">
        {t('home.hero.subtitle.mobile')}
      </span>
    </Fragment>
  </Hero>

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 2 · TABLÓN DE AVISOS — Isla Vue (runtime)
      ─────────────────────────────────────────────────────────────────────
      Posicionado en segundo lugar para que el usuario vea inmediatamente
      cualquier aviso urgente antes de explorar el resto del portal.
      Usa client:visible para hidratar solo al entrar en el viewport.
  ══════════════════════════════════════════════════════════════════════════ -->
  <Comunicados id="avisos" />

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 3 · ACCESO RÁPIDO — 4 Tarjetas (2 islas Vue + 2 estáticas)
      ─────────────────────────────────────────────────────────────────────
      Las tarjetas de Tasas y Calendario muestran datos en vivo desde
      PocketBase. Calculadora y Mapa son enlaces estáticos.
  ══════════════════════════════════════════════════════════════════════════ -->
  <AccesoRapidoHome id="herramientas" />

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 4 · PRODUCTOS Y SERVICIOS — Datos de src/data/categorias.ts
      ─────────────────────────────────────────────────────────────────────
      Las 5 categorías provienen del archivo estático categorias.ts,
      que es la fuente de verdad única para la estructura del catálogo.
      Este bloque es 100 % SSG — cero peticiones en build ni en runtime.
      Fondo azul suave: alterna con el bloque anterior (blanco).
  ══════════════════════════════════════════════════════════════════════════ -->
  <Features2
    id="productos"
    tagline={t('home.products.tagline')}
    title={t('home.products.title')}
    subtitle={t('home.products.subtitle')}
    columns={3}
    items={items}
  />

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 5 · Últimas Noticias — Isla Vue (runtime)
      ─────────────────────────────────────────────────────────────────────
  ══════════════════════════════════════════════════════════════════════════ -->
  <Noticias id="noticias" />

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 6 · APLICACIONES BANCARIAS — Estático
      ─────────────────────────────────────────────────────────────────────
      Información sobre EnZona y Transfermóvil, las plataformas de banca
      móvil compatibles con las cuentas del BPA. Los enlaces apuntan a
      páginas internas, no a CDNs externos (restricción air-gapped).
  ══════════════════════════════════════════════════════════════════════════ -->
  <Features3
    id="apps"
    tagline={t('home.digital.tagline')}
    title={t('home.digital.title')}
    subtitle={t('home.digital.subtitle')}
    columns={2}
    items={[
      {
        title: t('home.digital.enzona.title'),
        description: t('home.digital.enzona.desc'),
        icon: 'tabler:device-mobile-dollar',
        callToAction: {
          variant: 'link',
          text: t('home.digital.enzona.link'),
          href: 'https://www.enzona.net',
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('home.digital.transfermovil.title'),
        description: t('home.digital.transfermovil.desc'),
        icon: 'tabler:transfer',
        callToAction: {
          variant: 'link',
          text: t('home.digital.transfermovil.link'),
          href: 'https://www.etecsa.cu/es/aplicaciones/transfermovil',
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════════════════
      BLOQUE 7 · CALL TO ACTION — Contacto Rápido
      ─────────────────────────────────────────────────────────────────────
      Cierre de la página con acceso directo al formulario de contacto.
      Un único botón para no dispersar la atención del usuario.
      Fondo oscuro para crear contraste visual fuerte antes del footer.
  ══════════════════════════════════════════════════════════════════════════ -->
  <CallToAction
    title={t('home.cta.title')}
    subtitle={t('home.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('home.cta.button'),
        href: p('/contacto'),
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
