---
/**
 * @pagina   src/pages/[lang]/herramientas/mapa.astro
 * @ruta     /[lang]/herramientas/mapa
 *
 * @descripcion
 *   Página del módulo Mapa de Oficinas.
 *   Wrapper fino que delega la lógica reactiva a MapaSucursales.vue
 *   a través de Herramienta.astro.
 *
 *   Sin Leaflet, sin OpenStreetMap en la declaración de la página.
 *   Todo eso lo gestiona MapaSucursales.vue en el cliente.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText    → tagline + title + subtitle
 *   BLOQUE 2 · Herramienta → isla Vue MapaSucursales (client:load)
 *   BLOQUE 3 · CallToAction → información adicional sobre oficinas
 *   BLOQUE 4 · PageNav     → prev: "Volver a Herramientas"
 *
 * @colecciones  ninguna en build time
 *   puntos_de_atencion → consultada en el cliente por MapaSucursales.vue
 *   disponibilidad_at  → ídem
 */

import type { GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Herramienta from '~/components/sections/Herramienta.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('tools.map.hero.title')} — BPA Santiago de Cuba`,
  description: t('tools.map.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline "Herramientas" sitúa al usuario dentro del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('tools.map.hero.tagline')}
    title={t('tools.map.hero.title')}
    subtitle={t('tools.map.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Herramienta ───────────────────────────────────────────────────
      Monta la isla Vue MapaSucursales con client:load.
      El wrapper infiere max-w-6xl (el mapa necesita todo el ancho).
      El prop `lang` se inyecta internamente en Herramienta.astro.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Herramienta herramienta="mapa" id="mapa" />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Si el usuario necesita más información sobre las oficinas que
      la que ofrece el mapa (horarios generales, teléfonos, etc.).
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('tools.map.cta.title')}
    subtitle={t('tools.map.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('tools.map.cta.channels'),
        href: p('sobre-nosotros/nuestra-red/canales-de-atencion'),
        icon: 'tabler:phone',
      },
      {
        variant: 'secondary',
        text: t('tools.map.cta.network'),
        href: p('sobre-nosotros/nuestra-red/sucursales'),
        icon: 'tabler:building-bank',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Solo botón izquierdo: regresa al índice del módulo Herramientas.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('tools.nav.back.tools'), href: p('herramientas') }} />
</Layout>
