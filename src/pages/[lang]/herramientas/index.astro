---
/**
 * @pagina   src/pages/[lang]/herramientas/index.astro
 * @ruta     /[lang]/herramientas
 *
 * @descripcion
 *   Página índice del módulo de Herramientas Interactivas.
 *   Es una página completamente estática (SSG puro) — no consume PocketBase
 *   ni inyecta islas Vue. Todo su contenido semántico viene de es.ts / en.ts.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText    → tagline + title + subtitle
 *   BLOQUE 2 · Features2   → 4 tarjetas de herramientas
 *   BLOQUE 3 · CallToAction → cierre institucional → /contacto
 *   BLOQUE 4 · PageNav     → prev: "Volver a Inicio"
 *
 * @colecciones  ninguna — página estática
 */

import type { GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('tools.hero.title')} — BPA Santiago de Cuba`,
  description: t('tools.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Encabezado del módulo. El tagline "BPA Digital" sitúa al usuario
      dentro del área de herramientas digitales.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText tagline={t('tools.hero.tagline')} title={t('tools.hero.title')} subtitle={t('tools.hero.subtitle')} />

  <!-- BLOQUE 2 · Features2 — Catálogo de herramientas ─────────────────────────
      Cuatro tarjetas, una por herramienta. Cada callToAction apunta
      directamente a la subpágina correspondiente dentro del idioma activo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    columns={2}
    items={[
      {
        title: t('tools.index.calc.title'),
        description: t('tools.index.calc.desc'),
        icon: 'tabler:calculator',
        callToAction: {
          variant: 'link',
          text: t('tools.index.calc.link'),
          href: p('herramientas/calculadora'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('tools.index.rates.title'),
        description: t('tools.index.rates.desc'),
        icon: 'tabler:currency-dollar',
        callToAction: {
          variant: 'link',
          text: t('tools.index.rates.link'),
          href: p('herramientas/tasas-de-cambio'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('tools.index.map.title'),
        description: t('tools.index.map.desc'),
        icon: 'tabler:map-pin',
        callToAction: {
          variant: 'link',
          text: t('tools.index.map.link'),
          href: p('herramientas/mapa'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: t('tools.index.calendar.title'),
        description: t('tools.index.calendar.desc'),
        icon: 'tabler:calendar-event',
        callToAction: {
          variant: 'link',
          text: t('tools.index.calendar.link'),
          href: p('herramientas/calendario'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Si el usuario no encuentra lo que busca con las herramientas,
      se le orienta a contactar directamente al banco.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('tools.cta.title')}
    subtitle={t('tools.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('tools.cta.contact'),
        href: p('contacto'),
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Solo botón izquierdo: regresa al inicio. Las subpáginas del módulo
      tienen su propio PageNav con "Volver a Herramientas".
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('tools.nav.back'), href: p('') }} />
</Layout>
