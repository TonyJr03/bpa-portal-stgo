---
/**
 * @pagina   src/pages/[lang]/herramientas/calculadora.astro
 * @ruta     /[lang]/herramientas/calculadora
 *
 * @descripcion
 *   Página del módulo Calculadora Financiera.
 *   Wrapper fino que delega toda la lógica reactiva a la isla Vue
 *   CalculadoraFinanciera a través de Herramienta.astro.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText    → tagline + title + subtitle
 *   BLOQUE 2 · Herramienta → isla Vue CalculadoraFinanciera (client:load)
 *   BLOQUE 3 · CallToAction → siguiente paso natural tras calcular
 *   BLOQUE 4 · PageNav     → prev: "Volver a Herramientas"
 *
 * @colecciones  ninguna en build time
 *   tasas_intereses → consultada en el cliente por CalculadoraFinanciera.vue
 */

import type { GetStaticPaths } from 'astro';

import Layout       from '~/layouts/PageLayout.astro';
import HeroText     from '~/components/widgets/HeroText.astro';
import Herramienta  from '~/components/sections/Herramienta.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav      from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t        = useTranslations(lang);
const p        = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title:       `${t('tools.calc.hero.title')} — BPA Santiago de Cuba`,
  description: t('tools.calc.hero.subtitle'),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline "Herramientas" sitúa al usuario dentro del módulo.
      El HeroText cumple el rol de Headline; por eso Herramienta.astro
      no recibe title ni subtitle propios.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('tools.calc.hero.tagline')}
    title={t('tools.calc.hero.title')}
    subtitle={t('tools.calc.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Herramienta ───────────────────────────────────────────────────
      Monta la isla Vue CalculadoraFinanciera con client:load.
      El wrapper infiere max-w-2xl e inyecta el prop `lang` internamente.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Herramienta herramienta="calculadora" id="calculadora" />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      El paso natural tras calcular es ir a la sucursal o ver el catálogo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('tools.calc.cta.title')}
    subtitle={t('tools.calc.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text:    t('tools.calc.cta.map'),
        href:    p('herramientas/mapa'),
        icon:    'tabler:map-pin',
      },
      {
        variant: 'secondary',
        text:    t('tools.calc.cta.products'),
        href:    p('productos'),
        icon:    'tabler:layout-grid',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Solo botón izquierdo: regresa al índice del módulo Herramientas.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: t('tools.nav.back.tools'), href: p('herramientas') }}
  />

</Layout>
