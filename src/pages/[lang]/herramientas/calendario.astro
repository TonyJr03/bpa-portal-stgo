---
/**
 * @pagina   src/pages/[lang]/herramientas/calendario.astro
 * @ruta     /[lang]/herramientas/calendario
 *
 * @descripcion
 *   Página del módulo Calendario de Eventos.
 *   Wrapper fino que delega la lógica reactiva a CalendarioEventos.vue
 *   a través de Herramienta.astro.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText    → tagline + title + subtitle
 *   BLOQUE 2 · Herramienta → isla Vue CalendarioEventos (client:load)
 *   BLOQUE 3 · CallToAction → si el usuario tiene dudas sobre los pagos
 *   BLOQUE 4 · PageNav     → prev: "Volver a Herramientas"
 *
 * @colecciones  ninguna en build time
 *   eventos → consultada en el cliente por CalendarioEventos.vue
 */

import type { GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Herramienta from '~/components/sections/Herramienta.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('tools.calendar.hero.title')} — BPA Santiago de Cuba`,
  description: t('tools.calendar.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline "Herramientas" sitúa al usuario dentro del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('tools.calendar.hero.tagline')}
    title={t('tools.calendar.hero.title')}
    subtitle={t('tools.calendar.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Herramienta ───────────────────────────────────────────────────
      Monta la isla Vue CalendarioEventos con client:load.
      El wrapper infiere max-w-3xl e inyecta el prop `lang` internamente.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Herramienta herramienta="calendario" id="calendario" />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      El paso natural tras consultar el calendario es ir a la sucursal
      o contactar al banco para confirmar detalles de pago.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('tools.calendar.cta.title')}
    subtitle={t('tools.calendar.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('tools.calendar.cta.map'),
        href: p('herramientas/mapa'),
        icon: 'tabler:map-pin',
      },
      {
        variant: 'secondary',
        text: t('tools.calendar.cta.contact'),
        href: p('contacto'),
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Solo botón izquierdo: regresa al índice del módulo Herramientas.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('tools.nav.back.tools'), href: p('herramientas') }} />
</Layout>
