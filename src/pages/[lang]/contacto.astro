---
/**
 * @pagina  src/pages/contacto.astro
 * @ruta    /contacto
 *
 * @descripcion
 * Página dedicada de Contáctenos del portal institucional del BPA Santiago
 * de Cuba. Sigue la estructura estándar de páginas del proyecto.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText      → title + subtitle, sin tagline
 *   BLOQUE 2 · ContactoBPA   → widget propio (bg-bpa-alt)
 *                               Headline + grid SSG + isla Vue
 *   BLOQUE 3 · Steps         → proceso oficial de quejas (4 pasos, max-w-3xl)
 *   BLOQUE 4 · CallToAction  → enlaces a /herramientas/mapa y canales
 *   BLOQUE 5 · PageNav       → prev: "Volver a Inicio"
 *
 * @colecciones
 *   mensajes y quejas_sugerencias
 *   Gestionada por FormularioContacto.vue a través de
 *   ContactoBPA.astro. Ver schema completo en el JSDoc de ese widget.
 */

import Layout      from '~/layouts/PageLayout.astro';
import HeroText    from '~/components/widgets/HeroText.astro';
import ContactoBPA from '~/components/sections/ContactoBPA.astro';
import Steps       from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav     from '~/components/widgets/PageNav.astro';

const metadata = {
  title: 'Contáctenos — BPA Santiago de Cuba',
  description:
    'Comuníquese con el Banco Popular de Ahorro en Santiago de Cuba: envíe su mensaje o reclamación, consulte nuestros teléfonos, correos y horarios de atención.',
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ─────────────────────────────────────────────────────
      Página terminal — sin tagline, sin imagen.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    title="Contáctenos"
    subtitle="Escríbanos directamente o consulte los datos de la sede provincial. Atendemos consultas generales y reclamaciones formales."
  />

  <!-- BLOQUE 2 · ContactoBPA ───────────────────────────────────────────────────
      Widget propio que sigue el patrón AstroWind:
        WidgetWrapper → Headline → grid SSG (aside) + isla Vue (formulario).
      bg-bpa-alt alterna con el blanco del HeroText y del Steps siguiente.
  ─────────────────────────────────────────────────────────────────────────── -->
  <ContactoBPA id="formulario" />

  <!-- BLOQUE 3 · Steps — Proceso oficial de quejas ────────────────────────────
      Basado literalmente en "Parámetros que se necesitan para el tratamiento
      a las quejas, reclamaciones y sugerencias" (DOCX BPA 2024).
      max-w-3xl: proceso lineal, gana legibilidad en columna estrecha.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Steps
    tagline="Protocolo Oficial"
    title="¿Cómo presentar una queja o reclamación formal?"
    subtitle="Si su situación requiere una respuesta oficial del banco, siga estos pasos. Tiene derecho a recibir respuesta en un plazo máximo de 30 días hábiles."
    items={[
      {
        title: 'Reúna sus datos personales',
        description:
          'Necesitará: nombre y apellidos completos, dirección, municipio, provincia y un teléfono de contacto. Estos datos son imprescindibles para que el banco pueda localizarle y responder.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Identifique el motivo de su reclamación',
        description:
          'El BPA clasifica las reclamaciones en categorías: falta de información, demora en el servicio, inconformidad con un trámite, maltrato, servicios de pago a jubilados, créditos sociales, transferencias monetarias, títulos de propiedad u otros.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Describa los hechos con exactitud y claridad',
        description:
          'Explique qué ocurrió, cuándo, en qué sucursal o área del banco y qué trámite realizaba. Cuanto más precisa sea la descripción, más ágil será la resolución. Puede usar el formulario de la pestaña "Queja o Reclamación" en la sección anterior.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Aguarde la respuesta en el plazo establecido',
        description:
          'El banco está obligado a responder en un plazo máximo de 30 días hábiles desde la fecha de recepción. Si no recibe respuesta en ese período, puede escalar directamente a la Dirección Provincial.',
        icon: 'tabler:clock-check',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BLOQUE 4 · CallToAction ─────────────────────────────────────────────────
      Dos acciones: mapa de sucursales (primary) + canales de atención (secondary).
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿Prefiere visitarnos en persona?"
    subtitle="Consulte la ubicación exacta de todas nuestras sucursales, cajas de ahorro y cajeros automáticos en el mapa interactivo de la provincia."
    actions={[
      {
        variant: 'primary',
        text:    'Ver mapa de sucursales',
        href:    '/herramientas/mapa',
        icon:    'tabler:map-pin',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Página terminal del portal: sin botón next.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: 'Volver a Inicio', href: '/' }}
  />

</Layout>
