---
/**
 * @pagina  src/pages/[lang]/contacto.astro
 * @ruta    /es/contacto
 *          /en/contacto
 *
 * @descripcion
 * Página dedicada de Contáctenos del portal institucional del BPA Santiago
 * de Cuba. Sigue la estructura estándar de páginas del proyecto.
 *
 * Estructura:
 *   BLOQUE 1 · HeroText      → title + subtitle, sin tagline
 *   BLOQUE 2 · ContactoBPA   → widget propio (bg-bpa-alt)
 *                               Headline + grid SSG + isla Vue
 *   BLOQUE 3 · Steps         → proceso oficial de quejas (4 pasos, max-w-3xl)
 *   BLOQUE 4 · CallToAction  → enlaces a /herramientas/mapa y canales
 *   BLOQUE 5 · PageNav       → prev: "Volver a Inicio"
 *
 * @colecciones
 *   mensajes y quejas_sugerencias
 *   Gestionada por FormularioContacto.vue a través de
 *   ContactoBPA.astro. Ver schema completo en el JSDoc de ese widget.
 */

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactoBPA from '~/components/sections/ContactoBPA.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const metadata = {
  title: `${t('contact.hero.title')} — BPA Santiago de Cuba`,
  description: t('contact.hero.subtitle'),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ─────────────────────────────────────────────────────
      Página terminal — sin tagline, sin imagen.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText title={t('contact.hero.title')} subtitle={t('contact.hero.subtitle')} />

  <!-- BLOQUE 2 · ContactoBPA ───────────────────────────────────────────────────
      Widget propio que sigue el patrón AstroWind:
        WidgetWrapper → Headline → grid SSG (aside) + isla Vue (formulario).
      bg-bpa-alt alterna con el blanco del HeroText y del Steps siguiente.
  ─────────────────────────────────────────────────────────────────────────── -->
  <ContactoBPA id="formulario" />

  <!-- BLOQUE 3 · Steps — Proceso oficial de quejas ────────────────────────────
      Basado literalmente en "Parámetros que se necesitan para el tratamiento
      a las quejas, reclamaciones y sugerencias" (DOCX BPA 2024).
      max-w-3xl: proceso lineal, gana legibilidad en columna estrecha.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Steps
    tagline={t('contact.claims.tagline')}
    title={t('contact.claims.title')}
    subtitle={t('contact.claims.subtitle')}
    items={[
      {
        title: t('contact.claims.step1.title'),
        description: t('contact.claims.step1.desc'),
        icon: 'tabler:user-check',
      },
      {
        title: t('contact.claims.step2.title'),
        description: t('contact.claims.step2.desc'),
        icon: 'tabler:list-check',
      },
      {
        title: t('contact.claims.step3.title'),
        description: t('contact.claims.step3.desc'),
        icon: 'tabler:pencil',
      },
      {
        title: t('contact.claims.step4.title'),
        description: t('contact.claims.step4.desc'),
        icon: 'tabler:clock-check',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BLOQUE 4 · CallToAction ─────────────────────────────────────────────────
      Dos acciones: mapa de sucursales (primary) + canales de atención (secondary).
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('contact.cta.title')}
    subtitle={t('contact.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('contact.cta.button'),
        href: p('/herramientas/mapa'),
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Página terminal del portal: sin botón next.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('contact.nav.prev'), href: p('/') }} />
</Layout>
