---
/**
 * @pagina   src/pages/[lang]/actualidad/[slug].astro
 * @ruta     /es/actualidad/[slug]  |  /en/actualidad/[slug]
 *
 * @colecciones
 *   actualidad → publicado = true && slug != ""
 *   documentos → referencia = slug && tipo = "noticia"
 *   Campos nuevos: titulo_en, resumen_en, contenido_en
 */

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { marked } from 'marked';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProseContent from '~/components/sections/ProseContent.astro';
import DocumentosDescargables from '~/components/widgets/DocumentosDescargables.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import EmptyCollection from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';

import { LANGS, useTranslations, useFieldTranslation, useLocalTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';
import { pb, fetchParaBuild } from '~/lib/pocketbase';

interface Registro {
  id: string;
  titulo: string;
  titulo_en: string;
  slug: string;
  resumen: string;
  resumen_en: string;
  contenido: string;
  contenido_en: string;
  fecha: string;
  nivel: 'informativo' | 'alerta' | 'urgente';
  categoria: 'comunicado' | 'noticia';
  publicado: boolean;
  imagen: string;
  collectionId: string;
}

interface Documento {
  id: string;
  nombre: string;
  archivo: string;
  referencia: string;
  tipo: string;
  orden: number;
  collectionId: string;
  collectionName: string;
}

// ── Diccionarios de traducción para badges ──────────────────────────────────
const BADGE_NIVEL = {
  es: { alerta: 'Alerta', urgente: 'Urgente' },
  en: { alerta: 'Alert', urgente: 'Urgent' },
} as const;

const BADGE_CATEGORIA = {
  es: { comunicado: 'Comunicado', noticia: 'Noticia' },
  en: { comunicado: 'Announcement', noticia: 'News' },
} as const;

const BADGE_NIVEL_CLASS = {
  alerta: 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300',
  urgente: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
} as const;

const BADGE_CAT_CLASS = 'bg-bpa-100 text-bpa-800 dark:bg-bpa-amber-800/40 dark:text-bpa-amber-200';

// ── Badge Helper ────────────────────────────────────────────────────────────
// Centraliza la lógica: si es alerta/urgente → muestra nivel (color fuerte)
//                       si es informativo → muestra categoría (color suave)
interface BadgeInfo {
  label: string;
  class: string;
  tagline: string;
}

function getBadgeInfo(nivel: string, categoria: string, lang: string): BadgeInfo {
  const isCritical = nivel === 'alerta' || nivel === 'urgente';

  if (isCritical) {
    // Mostrar nivel (alerta/urgente) con clase de alerta
    return {
      label: BADGE_NIVEL[lang as keyof typeof BADGE_NIVEL][nivel as keyof (typeof BADGE_NIVEL)['es']],
      class: BADGE_NIVEL_CLASS[nivel as keyof typeof BADGE_NIVEL_CLASS],
      tagline: BADGE_CATEGORIA[lang as keyof typeof BADGE_CATEGORIA][categoria as keyof (typeof BADGE_CATEGORIA)['es']],
    };
  } else {
    // Mostrar categoría (comunicado/noticia) con clase suave
    return {
      label: BADGE_CATEGORIA[lang as keyof typeof BADGE_CATEGORIA][categoria as keyof (typeof BADGE_CATEGORIA)['es']],
      class: BADGE_CAT_CLASS,
      tagline: BADGE_CATEGORIA[lang as keyof typeof BADGE_CATEGORIA][categoria as keyof (typeof BADGE_CATEGORIA)['es']],
    };
  }
}

export const getStaticPaths = (async () => {
  const registros = await fetchParaBuild<Registro>(
    () =>
      pb.collection('actualidad').getFullList<Registro>({
        filter: 'publicado = true && slug != ""',
        sort: '-updated',
      }),
    'actualidad'
  );

  const paths = await Promise.all(
    registros.map(async (r) => {
      let documentos: Documento[] = [];
      let dbErrorDocs = false;
      try {
        documentos = await pb.collection('documentos').getFullList<Documento>({
          filter: `referencia = "${r.slug}" && tipo = "noticia"`,
          sort: 'orden',
        });
      } catch (err) {
        console.error(`[BPA] Error cargando documentos para "${r.slug}":`, err);
        dbErrorDocs = true;
      }

      return LANGS.map((lang) => ({
        params: { lang, slug: r.slug },
        props: { registro: r, documentos, dbErrorDocs },
      }));
    })
  );

  return paths.flat(2);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { registro, documentos, dbErrorDocs } = Astro.props as Props;
const { lang } = Astro.params;
const t = useTranslations(lang);
const tf = useFieldTranslation(lang);
const p = (slug: string) => getPermalink(slug, lang);
const tl = useLocalTranslations(lang, {
  es: { locale: 'es-CU', empty: 'El contenido detallado de este artículo no está disponible todavía.' },
  en: { locale: 'en-US', empty: 'Detailed content for this article is not available yet.' },
});

// Campos traducidos
const tituloTraducido = tf(registro.titulo, registro.titulo_en);
const contenidoRaw = tf(registro.contenido, registro.contenido_en);
const contenidoHtml = contenidoRaw?.trim() ? (marked.parse(contenidoRaw) as string) : '';

// Badge y tagline según nivel y categoría
const badge = getBadgeInfo(registro.nivel, registro.categoria, lang);

const fechaFormateada = new Intl.DateTimeFormat(tl('locale'), {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(new Date(registro.fecha));

const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id: doc.id,
  nombre: doc.nombre,
  archivo: doc.archivo,
  url: pb.files.getURL(doc, doc.archivo),
  orden: doc.orden,
}));

const metadata = {
  title: `${tituloTraducido} — BPA Santiago de Cuba`,
  description: tf(registro.resumen, registro.resumen_en),
};
---

<Layout metadata={metadata}>
  <HeroText tagline={badge.tagline} title={tituloTraducido} />

  <!-- Badges + fecha -->
  <section class="relative not-prose">
    <div class="max-w-4xl mx-auto px-4 md:px-6 pb-6 flex flex-wrap items-center gap-3">
      <span class:list={['inline-flex items-center text-sm font-semibold px-3 py-1 rounded-full', badge.class]}>
        {badge.label}
      </span>
      <span class="text-muted text-sm flex items-center gap-2">
        <span class="w-1 h-1 rounded-full bg-bpa-200 dark:bg-bpa-amber-800 inline-block"></span>
        {fechaFormateada}
      </span>
    </div>
  </section>

  {
    contenidoHtml ? (
      <ProseContent contenido={contenidoHtml} />
    ) : (
      <EmptyCollection coleccion="actualidad" mensaje={tl('empty')} icono="tabler:article-off" />
    )
  }

  <DocumentosDescargables documentos={documentosConUrl} error={dbErrorDocs} titulo={t('news.detail.docs')} />

  <CallToAction
    title={t('news.detail.cta.title')}
    subtitle={t('news.detail.cta.subtitle')}
    actions={[
      { variant: 'primary', text: t('news.detail.cta.btn1'), href: p('contacto'), icon: 'tabler:headset' },
      { variant: 'secondary', text: t('news.detail.cta.btn2'), href: p('actualidad'), icon: 'tabler:news' },
    ]}
  />

  <PageNav prev={{ text: t('news.detail.nav.prev'), href: p('actualidad') }} />
</Layout>
