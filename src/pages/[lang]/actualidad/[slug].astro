---
/**
 * @pagina   src/pages/actualidad/[slug].astro
 * @ruta     /actualidad/[slug]
 *
 * Página de detalle de un registro de la colección `actualidad`.
 * Ordena por -updated en getStaticPaths para procesar primero los más recientes.
 *
 * @coleccion  actualidad  (antes: noticias)
 */

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { marked }               from 'marked';
import Layout                   from '~/layouts/PageLayout.astro';
import HeroText                 from '~/components/widgets/HeroText.astro';
import ProseContent             from '~/components/sections/ProseContent.astro';
import DocumentosDescargables   from '~/components/widgets/DocumentosDescargables.astro';
import CallToAction             from '~/components/widgets/CallToAction.astro';
import PageNav                  from '~/components/widgets/PageNav.astro';
import EmptyCollection          from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';
import { pb, fetchParaBuild }   from '~/lib/pocketbase';

interface Registro {
  id:           string;
  titulo:       string;
  slug:         string;
  resumen:      string;
  contenido:    string;
  fecha:        string;
  nivel:        'informativo' | 'alerta' | 'urgente';
  categoria:    'comunicado' | 'noticia';
  publicado:    boolean;
  imagen:       string;
  collectionId: string;
}

interface Documento {
  id: string; nombre: string; archivo: string;
  referencia: string; tipo: string; orden: number;
  collectionId: string; collectionName: string;
}

const BADGE_CATEGORIA = 'bg-bpa-100 text-bpa-800 dark:bg-bpa-amber-800/40 dark:text-bpa-amber-200';
const LABEL_CATEGORIA: Record<string, string> = { comunicado: 'Comunicado', noticia: 'Noticia' };
const BADGE_NIVEL: Record<string, string> = {
  alerta:  'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300',
  urgente: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
};
const LABEL_NIVEL: Record<string, string> = { alerta: 'Alerta', urgente: 'Urgente' };

export const getStaticPaths = (async () => {
  const registros = await fetchParaBuild<Registro>(
    () => pb.collection('actualidad').getFullList<Registro>({
      filter: 'publicado = true && slug != ""',
      sort:   '-updated',
    }),
    'actualidad'
  );

  const paths = await Promise.all(
    registros.map(async (r) => {
      let documentos: Documento[] = [];
      let dbErrorDocs = false;
      try {
        documentos = await pb.collection('documentos').getFullList<Documento>({
          filter: `referencia = "${r.slug}" && tipo = "noticia"`,
          sort:   'orden',
        });
      } catch (err) {
        console.error(`[BPA] Error cargando documentos para "${r.slug}":`, err);
        dbErrorDocs = true;
      }
      return { params: { slug: r.slug }, props: { registro: r, documentos, dbErrorDocs } };
    })
  );

  return paths;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { registro, documentos, dbErrorDocs } = Astro.props;

const contenidoHtml = registro.contenido?.trim()
  ? marked.parse(registro.contenido) as string
  : '';

const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id: doc.id, nombre: doc.nombre, archivo: doc.archivo,
  url: pb.files.getURL(doc, doc.archivo), orden: doc.orden,
}));

const fechaFormateada = new Intl.DateTimeFormat('es-CU', {
  day: '2-digit', month: 'long', year: 'numeric',
}).format(new Date(registro.fecha));

const tagline  = LABEL_CATEGORIA[registro.categoria] ?? 'Actualidad';
const metadata = {
  title:       `${registro.titulo} — BPA Santiago de Cuba`,
  description: registro.resumen,
};
---

<Layout metadata={metadata}>

  <HeroText tagline={tagline} title={registro.titulo} />

  <!-- Badges de categoría y nivel + fecha -->
  <section class="relative not-prose">
    <div class="max-w-4xl mx-auto px-4 md:px-6 pb-6 flex flex-wrap items-center gap-3">

      <span class:list={['inline-flex items-center text-sm font-semibold px-3 py-1 rounded-full', BADGE_CATEGORIA]}>
        {LABEL_CATEGORIA[registro.categoria]}
      </span>

      {(registro.nivel === 'alerta' || registro.nivel === 'urgente') && (
        <span class:list={[
          'inline-flex items-center text-sm font-semibold px-3 py-1 rounded-full',
          BADGE_NIVEL[registro.nivel],
        ]}>
          {LABEL_NIVEL[registro.nivel]}
        </span>
      )}

      <span class="text-muted text-sm flex items-center gap-2">
        <span class="w-1 h-1 rounded-full bg-bpa-200 dark:bg-bpa-amber-800 inline-block"></span>
        {fechaFormateada}
      </span>
    </div>
  </section>

  {contenidoHtml
    ? <ProseContent contenido={contenidoHtml} />
    : <EmptyCollection
        coleccion="actualidad"
        mensaje="El contenido detallado de este artículo no está disponible todavía."
        icono="tabler:article-off"
      />
  }

  <DocumentosDescargables
    documentos={documentosConUrl}
    error={dbErrorDocs}
    titulo="Documentos adjuntos"
  />

  <CallToAction
    title="¿Tiene alguna consulta sobre este aviso?"
    subtitle="Nuestros canales de atención están disponibles para aclarar cualquier duda."
    actions={[
      { variant: 'primary',   text: 'Contáctenos',       href: '/contacto',   icon: 'tabler:headset' },
      { variant: 'secondary', text: 'Ver más actualidad', href: '/actualidad', icon: 'tabler:news'    },
    ]}
  />

  <PageNav prev={{ text: 'Volver a Actualidad', href: '/actualidad' }} />

</Layout>
