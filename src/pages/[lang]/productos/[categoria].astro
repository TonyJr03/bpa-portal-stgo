---
/**
 * @pagina   src/pages/[lang]/productos/[categoria].astro
 * @ruta     /es/productos/[categoria]  |  /en/productos/[categoria]
 *
 *  @descripcion
 * Página dinámica generada en build time para cada categoría de productos.
 * getStaticPaths itera sobre las 5 categorías definidas en src/data/categorias.ts
 * y por cada una carga sus productos publicados desde PocketBase.
 *
 * El campo `categoria` de la colección `productos` es de tipo Select y almacena
 * el slug de la categoría (ej: "banca-personal"), por lo que el filtro usa el
 * slug directamente — sin necesidad de IDs de PocketBase.
 *
 * @colecciones
 *   productos → categoria = slug && publicado = true
 *   Campos nuevos: nombre_en, descripcion_en
 */

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout          from '~/layouts/PageLayout.astro';
import HeroText        from '~/components/widgets/HeroText.astro';
import Features2       from '~/components/widgets/Features2.astro';
import CallToAction    from '~/components/widgets/CallToAction.astro';
import PageNav         from '~/components/widgets/PageNav.astro';
import EmptyCollection from '~/components/ui/EmptyCollection.astro';
import DatabaseError   from '~/components/ui/DatabaseError.astro';

import { LANGS, useTranslations, useFieldTranslation, useLocalTranslations } from '~/i18n/utils';
import { getPermalink }                           from '~/utils/permalinks';
import { pb, fetchParaBuild }                     from '~/lib/pocketbase';
import { CATEGORIAS }                             from '~/data/categorias';

interface Producto {
  id:             string;
  nombre:         string;
  nombre_en:      string;
  slug:           string;
  descripcion:    string;
  descripcion_en: string;
  icono:          string;
  orden:          number;
  publicado:      boolean;
  categoria:      string;
}

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    CATEGORIAS.map(async (cat) => {
      const productos = await fetchParaBuild<Producto>(
        () => pb.collection('productos').getFullList<Producto>({
          filter: `categoria = "${cat.slug}" && publicado = true`,
          sort:   'orden',
        }),
        `productos/${cat.slug}`
      );

      const dbError = productos.length === 0;

      // Una ruta por idioma × por categoría
      return LANGS.map((lang) => ({
        params: { lang, categoria: cat.slug },
        props:  { productos, dbError },
      }));
    })
  );

  return paths.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { productos, dbError } = Astro.props as Props;
const { lang, categoria } = Astro.params;
const t  = useTranslations(lang);
const tf = useFieldTranslation(lang);
const p = (slug: string) => getPermalink(slug, lang);
const tl = useLocalTranslations(lang, {
  es: {
    dbError:       'No pudimos acceder a la información de los productos. Por favor, intente más tarde o contacte con nosotros.',
    emptyTemplate: 'No hay productos publicados en {cat} por el momento.',
  },
  en: {
    dbError:       'We could not access the product information. Please try again later or contact us.',
    emptyTemplate: 'No products are currently published in {cat}.',
  },
});
const items = productos.map((prod) => ({
  title:       tf(prod.nombre, prod.nombre_en),
  description: tf(prod.descripcion, prod.descripcion_en),
  icon:        `tabler:${prod.icono}`,
  callToAction: {
    text:    t('products.view'),
    href:    p(`productos/${categoria}/${prod.slug}`),
    variant: 'link' as const,
    icon:    'tabler:arrow-right',
  },
}));

const metadata = {
  title:       `${t(`cat.${categoria}.nombre`)} — BPA Santiago de Cuba`,
  description: t(`cat.${categoria}.desc`),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline contextualiza la ubicación dentro del portal.
      Title = nombre de la categoría. Subtitle = descripción de la categoría.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    tagline={t('products.tagline.parent')}
    title={t(`cat.${categoria}.nombre`)}
    subtitle={t(`cat.${categoria}.desc`)}
  />

  <!-- BLOQUE 2 · Features2 / estados ──────────────────────────────────────────
      Tres casos posibles según el resultado de la consulta a PocketBase:
        1. Error de conexión → DatabaseError
        2. Sin productos     → EmptyCollection
        3. Con productos     → Features2 con el grid
  ─────────────────────────────────────────────────────────────────────────── -->
  {dbError ? (
    <DatabaseError
      coleccion="productos"
      mensaje={tl('dbError')}
    />
  ) : items.length === 0 ? (
    <EmptyCollection
      coleccion="productos"
      mensaje={tl('emptyTemplate').replace('{cat}', t(`cat.${categoria}.nombre`))}
      icono="tabler:package-off"
    />
  ) : (
    <Features2
      id="productos"
      tagline={t('products.select.tagline')}
      columns={3}
      items={items}
    />
  )}

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional consistente con el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('products.cta.title')}
    subtitle={t('products.cta.subtitle')}
    actions={[{
      variant: 'primary',
      text:    t('products.cta.button'),
      href:    p('contacto'),
      icon:    'tabler:headset',
    }]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Navegación contextual: regresa al índice de Productos y Servicios.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('products.nav.back'), href: p('productos') }} />

</Layout>
