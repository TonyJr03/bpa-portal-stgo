---
/**
 * @pagina   src/pages/[lang]/productos/[categoria]/[producto].astro
 * @ruta     /es/productos/[categoria]/[producto]
 *           /en/productos/[categoria]/[producto]
 *
 * @descripcion
 * Página de detalle de un producto o servicio individual. Muestra el contenido
 * completo renderizado desde Markdown almacenado en PocketBase, más un bloque
 * de descarga de documentos asociados.
 *
 * El campo `contenido` de la colección `productos` almacena texto en formato
 * Markdown (Plain Text en PocketBase). Se convierte a HTML con `marked.parse()`
 * en build time antes de pasarlo a ProseContent — sin JS en el cliente.
 *
 * getStaticPaths itera sobre las 5 categorías estáticas (src/data/categorias.ts),
 * carga los productos de cada una filtrando por el slug de la categoría, y por
 * cada producto carga sus documentos descargables. Todo el fetching ocurre aquí.
 *
 * @colecciones
 *   productos  → categoria = slug && publicado = true
 *   documentos → referencia = slug && tipo = "producto"
 *   Campos nuevos: nombre_en, descripcion_en, contenido_en
 */

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { marked } from 'marked';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProseContent from '~/components/sections/ProseContent.astro';
import DocumentosDescargables from '~/components/widgets/DocumentosDescargables.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav from '~/components/widgets/PageNav.astro';
import EmptyCollection from '~/components/ui/EmptyCollection.astro';
import type { DocumentoConUrl } from '~/components/widgets/DocumentosDescargables.astro';

import { LANGS, useTranslations, useFieldTranslation, useLocalTranslations } from '~/i18n/utils';
import { getPermalink } from '~/utils/permalinks';
import { pb, fetchParaBuild } from '~/lib/pocketbase';
import { CATEGORIAS_SLUGS } from '~/data/categorias';

interface Producto {
  id: string;
  nombre: string;
  nombre_en: string;
  slug: string;
  descripcion: string;
  descripcion_en: string;
  contenido: string;
  contenido_en: string;
  icono: string;
  orden: number;
  publicado: boolean;
  categoria: string;
}

interface Documento {
  id: string;
  nombre: string;
  archivo: string;
  referencia: string;
  tipo: string;
  orden: number;
  collectionId: string;
  collectionName: string;
}

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    CATEGORIAS_SLUGS.map(async (cat) => {
      const productos = await fetchParaBuild<Producto>(
        () =>
          pb.collection('productos').getFullList<Producto>({
            filter: `categoria = "${cat.slug}" && publicado = true`,
            sort: 'orden',
          }),
        `productos/${cat.slug}`
      );

      if (productos.length === 0) return [];

      return Promise.all(
        productos.map(async (prod) => {
          let documentos: Documento[] = [];
          let dbErrorDocs = false;

          try {
            documentos = await pb.collection('documentos').getFullList<Documento>({
              filter: `referencia = "${prod.slug}" && tipo = "producto"`,
              sort: 'orden',
            });
          } catch (err) {
            console.error(`[BPA] Error cargando documentos para "${prod.slug}":`, err);
            dbErrorDocs = true;
          }

          // Una ruta por idioma × por producto
          return LANGS.map((lang) => ({
            params: { lang, categoria: cat.slug, producto: prod.slug },
            props: { producto: prod, documentos, dbErrorDocs },
          }));
        })
      );
    })
  );

  return paths.flat(3);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { producto, documentos, dbErrorDocs } = Astro.props as Props;
const { lang, categoria } = Astro.params;
const t = useTranslations(lang);
const tf = useFieldTranslation(lang);
const p = (slug: string) => getPermalink(slug, lang);
const tl = useLocalTranslations(lang, {
  es: { empty: 'La información detallada sobre este producto no está disponible todavía.' },
  en: { empty: 'Detailed information about this product is not available yet.' },
});

const nombreTraducido = tf(producto.nombre, producto.nombre_en);
const contenidoRaw = tf(producto.contenido, producto.contenido_en);
const contenidoHtml = contenidoRaw?.trim() ? (marked.parse(contenidoRaw) as string) : '';

const documentosConUrl: DocumentoConUrl[] = documentos.map((doc) => ({
  id: doc.id,
  nombre: doc.nombre,
  archivo: doc.archivo,
  url: pb.files.getURL(doc, doc.archivo),
  orden: doc.orden,
}));

const metadata = {
  title: `${nombreTraducido} — BPA Santiago de Cuba`,
  description: tf(producto.descripcion, producto.descripcion_en),
};
---

<Layout metadata={metadata}>
  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Tagline = nombre de la categoría para contextualizar la ubicación.
      Title = nombre del producto. Sin subtitle: el contenido habla por sí mismo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText tagline={t(`cat.${categoria}.nombre`)} title={nombreTraducido} />

  <!-- BLOQUE 2 · ProseContent / EmptyCollection ───────────────────────────────
      Si el campo `contenido` tiene datos → convierte Markdown a HTML y renderiza
      con Tailwind Typography. Si está vacío → EmptyCollection avisa al usuario.
  ─────────────────────────────────────────────────────────────────────────── -->
  {
    contenidoHtml ? (
      <ProseContent contenido={contenidoHtml} />
    ) : (
      <EmptyCollection coleccion="productos" mensaje={tl('empty')} icono="tabler:info-circle" />
    )
  }

  <!-- BLOQUE 3 · DocumentosDescargables ───────────────────────────────────────
      Grid de archivos descargables asociados a este producto.
      - Si error=true  → aviso ámbar discreto (no bloquea la página).
      - Si array vacío → el componente no renderiza nada (silencioso).
      - Si hay docs    → grid de tarjetas con botón de descarga.
  ─────────────────────────────────────────────────────────────────────────── -->
  <DocumentosDescargables documentos={documentosConUrl} error={dbErrorDocs} titulo={t('products.detail.docs')} />

  <!-- BLOQUE 4 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional consistente con el resto del módulo.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('products.detail.cta.title')}
    subtitle={t('products.detail.cta.subtitle')}
    actions={[
      {
        variant: 'primary',
        text: t('products.detail.cta.button'),
        href: p('contacto'),
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 5 · PageNav ───────────────────────────────────────────────────────
      Navegación contextual: regresa al listado de la categoría padre.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{
      text: `${t('products.detail.nav.back')} ${t(`cat.${categoria}.nombre`)}`,
      href: p(`productos/${categoria}`),
    }}
  />
</Layout>
