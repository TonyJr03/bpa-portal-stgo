---
/**
 * @pagina src/pages/productos/index.astro
 * @ruta   /productos
 *
 * @descripcion
 * Página de índice de "Productos y Servicios".
 * Lista las 5 categorías de la cartera comercial del BPA Santiago de Cuba.
 * Cada categoría enlaza a su página dinámica /productos/[categoria].
 *
 * Las categorías son datos estáticos definidos en src/data/categorias.ts —
 * no se consulta PocketBase en esta página.
 */

// ── Imports ────────────────────────────────────────────────────────────────────
import Layout       from '~/layouts/PageLayout.astro';
import HeroText     from '~/components/widgets/HeroText.astro';
import Features2    from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav      from '~/components/widgets/PageNav.astro';
import { CATEGORIAS } from '~/data/categorias';

// ── Mapeo a Item[] para Features2 ─────────────────────────────────────────────
const items = CATEGORIAS.map((cat) => ({
  title:       cat.nombre,
  description: cat.descripcion,
  icon:        `tabler:${cat.icono}`,
  callToAction: {
    text:    'Ver productos',
    href:    `/productos/${cat.slug}`,
    variant: 'link' as const,
    icon:    'tabler:arrow-right',
  },
}));

// ── Metadata SEO ──────────────────────────────────────────────────────────────
const metadata = {
  title:       'Productos y Servicios — BPA Santiago de Cuba',
  description: 'Conozca toda la cartera de productos y servicios del Banco Popular de Ahorro en Santiago de Cuba: ahorro, créditos, banca electrónica, servicios internacionales y más.',
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Título y subtítulo institucional de la sección. Sin tagline.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    title="Productos y Servicios"
    subtitle="Conozca la cartera completa de productos financieros diseñados para personas naturales, empresas y la comunidad en general."
  />

  <!-- BLOQUE 2 · Features2 ─────────────────────────────────────────────────────
      Grid de las 5 categorías. Datos estáticos — sin estados de error ni vacío.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    id="categorias"
    tagline="Seleccione una categoría"
    columns={3}
    items={items}
  />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional. Un solo botón hacia Contacto.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title="¿No sabe cuál producto es el adecuado para usted?"
    subtitle="Nuestros especialistas en cada sucursal de Santiago de Cuba están disponibles para orientarle sin compromiso."
    actions={[
      {
        variant: 'primary',
        text:    'Contáctenos',
        href:    '/contacto',
        icon:    'tabler:headset',
      },
    ]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Botón izquierdo para volver a Inicio.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav
    prev={{ text: 'Volver a Inicio', href: '/' }}
  />

</Layout>
