---
/**
 * @pagina   src/pages/[lang]/productos/index.astro
 * @ruta     /es/productos  |  /en/productos
 *
 * @descripcion
 * Página de índice de "Productos y Servicios".
 * Lista las 5 categorías de la cartera comercial del BPA Santiago de Cuba.
 * Cada categoría enlaza a su página dinámica /productos/[categoria].
 *
 * Las categorías son datos estáticos definidos en src/data/categorias.ts —
 * no se consulta PocketBase en esta página.
 */

import type { GetStaticPaths } from 'astro';
import Layout       from '~/layouts/PageLayout.astro';
import HeroText     from '~/components/widgets/HeroText.astro';
import Features2    from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PageNav      from '~/components/widgets/PageNav.astro';

import { LANGS, useTranslations } from '~/i18n/utils';
import { getPermalink }           from '~/utils/permalinks';
import { CATEGORIAS }              from '~/data/categorias';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))
) satisfies GetStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang);
const p = (slug: string) => getPermalink(slug, lang);

const items = CATEGORIAS.map((cat) => ({
  title:       t(`cat.${cat.slug}.nombre`),
  description: t(`cat.${cat.slug}.desc`),
  icon:        `tabler:${cat.icono}`,
  callToAction: {
    variant: 'link' as const,
    text:    t('products.view'),
    href:    p(`productos/${cat.slug}`),
    icon:    'tabler:arrow-right',
  },
}));

const metadata = {
  title: `${t('products.hero.title')} — BPA Santiago de Cuba`,
  description: t('products.hero.subtitle'),
};
---

<Layout metadata={metadata}>

  <!-- BLOQUE 1 · HeroText ──────────────────────────────────────────────────────
      Título y subtítulo institucional de la sección. Sin tagline.
  ─────────────────────────────────────────────────────────────────────────── -->
  <HeroText
    title={t('products.hero.title')}
    subtitle={t('products.hero.subtitle')}
  />

  <!-- BLOQUE 2 · Features2 ─────────────────────────────────────────────────────
      Grid de las 5 categorías. Datos estáticos — sin estados de error ni vacío.
  ─────────────────────────────────────────────────────────────────────────── -->
  <Features2
    id="categorias"
    tagline={t('products.tagline')}
    columns={3}
    items={items}
  />

  <!-- BLOQUE 3 · CallToAction ──────────────────────────────────────────────────
      Cierre institucional. Un solo botón hacia Contacto.
  ─────────────────────────────────────────────────────────────────────────── -->
  <CallToAction
    title={t('products.cta.title')}
    subtitle={t('products.cta.subtitle')}
    actions={[{
      variant: 'primary',
      text:    t('products.cta.button'),
      href:    p('contacto'),
      icon:    'tabler:headset',
    }]}
  />

  <!-- BLOQUE 4 · PageNav ───────────────────────────────────────────────────────
      Botón izquierdo para volver a Inicio.
  ─────────────────────────────────────────────────────────────────────────── -->
  <PageNav prev={{ text: t('products.nav.prev'), href: p('') }} />

</Layout>
